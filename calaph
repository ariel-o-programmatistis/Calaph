        case 0x03BC: return 39; /* μ */
        case 0x03BD: return 40; /* ν */
        case 0x03BE: return 41; /* ξ */
        case 0x03BF: return 42; /* ο */
        case 0x03C0: return 43; /* π */
        case 0x03C1: return 44; /* ρ */
        case 0x03C3: return 45; /* σ */
        case 0x03C4: return 46; /* τ */
        case 0x03C5: return 47; /* υ */
        case 0x03C6: return 48; /* φ */
        case 0x03C7: return 49; /* χ */
        case 0x03C8: return 50; /* ψ */
        case 0x03C9: return 51; /* ω */
    }

    /*
     * CIRÍLICO.
     *
     * Se utiliza un orden estable de las letras rusas
     * principales, más Ё.
     */

    switch (cp) {
        case 0x0410: return 52; /* А */
        case 0x0411: return 53; /* Б */
        case 0x0412: return 54; /* В */
        case 0x0413: return 55; /* Г */
        case 0x0414: return 56; /* Д */
        case 0x0415: return 57; /* Е */
        case 0x0401: return 58; /* Ё */
        case 0x0416: return 59; /* Ж */
        case 0x0417: return 60; /* З */
