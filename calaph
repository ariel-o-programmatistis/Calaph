        case 47: return 0x03A5;
        case 48: return 0x03A6;
        case 49: return 0x03A7;
        case 50: return 0x03A8;
        case 51: return 0x03A9;

        case 52: return 0x0410;
        case 53: return 0x0411;
        case 54: return 0x0412;
        case 55: return 0x0413;
        case 56: return 0x0414;
        case 57: return 0x0415;
        case 58: return 0x0401;
        case 59: return 0x0416;
        case 60: return 0x0417;
        case 61: return 0x0418;
        case 62: return 0x0419;
        case 63: return 0x041A;
        case 64: return 0x041B;
        case 65: return 0x041C;
