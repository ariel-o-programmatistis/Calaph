#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <limits.h>
#include <ctype.h>

/*
 * CALAPH
 *
 * Sistema de escritura basado en expresiones numéricas.
 *
 * Primitivas:
 *   <> = 0
 *   .  = 1
 *   ,  = 3
 *
 * Operadores:
 *   '  = multiplicación
 *   espacio simple = suma
 *
 * En texto:
 *   /       = espacio ordinario
 *   dos o más espacios = separación entre caracteres
 *
 * No contiene conversiones a Binary, Hexadecimal ni Morse.
 */

#define INPUT_SIZE 4096
#define OUTPUT_SIZE 16384

/* ============================================================
 * ENTRADA
 * ============================================================ */

static void read_line(char *buffer, size_t size)
{
    if (buffer == NULL || size == 0)
        return;

    if (fgets(buffer, (int)size, stdin) == NULL) {
        buffer[0] = '\0';
        return;
    }

    size_t len = strlen(buffer);

    if (len > 0 && buffer[len - 1] == '\n')
        buffer[len - 1] = '\0';
}

/* ============================================================
 * UTF-8
 * ============================================================ */

static int utf8_decode(const unsigned char *s, uint32_t *codepoint)
{
    if (s == NULL || codepoint == NULL)
        return 0;

    if (s[0] < 0x80) {
        *codepoint = s[0];
        return 1;
    }

    if ((s[0] & 0xE0) == 0xC0) {
        if ((s[1] & 0xC0) != 0x80)
            return 0;

        uint32_t cp =
            ((uint32_t)(s[0] & 0x1F) << 6) |
            (uint32_t)(s[1] & 0x3F);

        if (cp < 0x80)
            return 0;

        *codepoint = cp;
        return 2;
    }

    if ((s[0] & 0xF0) == 0xE0) {
        if ((s[1] & 0xC0) != 0x80 ||
            (s[2] & 0xC0) != 0x80)
            return 0;

        uint32_t cp =
            ((uint32_t)(s[0] & 0x0F) << 12) |
            ((uint32_t)(s[1] & 0x3F) << 6) |
            (uint32_t)(s[2] & 0x3F);

        if (cp < 0x800)
            return 0;

        if (cp >= 0xD800 && cp <= 0xDFFF)
            return 0;

        *codepoint = cp;
        return 3;
    }

    if ((s[0] & 0xF8) == 0xF0) {
        if ((s[1] & 0xC0) != 0x80 ||
            (s[2] & 0xC0) != 0x80 ||
            (s[3] & 0xC0) != 0x80)
            return 0;

        uint32_t cp =
            ((uint32_t)(s[0] & 0x07) << 18) |
            ((uint32_t)(s[1] & 0x3F) << 12) |
            ((uint32_t)(s[2] & 0x3F) << 6) |
            (uint32_t)(s[3] & 0x3F);

        if (cp < 0x10000 || cp > 0x10FFFF)
            return 0;

        *codepoint = cp;
        return 4;
    }

    return 0;
}

static int utf8_encode(uint32_t cp, char *out, size_t size)
{
    if (out == NULL || size == 0)
        return 0;

    if (cp <= 0x7F) {
        if (size < 2)
            return 0;

        out[0] = (char)cp;
        out[1] = '\0';
        return 1;
    }

    if (cp <= 0x7FF) {
        if (size < 3)
            return 0;

        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        out[2] = '\0';
        return 2;
    }

    if (cp >= 0xD800 && cp <= 0xDFFF)
        return 0;

    if (cp <= 0xFFFF) {
        if (size < 4)
            return 0;

        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        out[3] = '\0';
        return 3;
    }

    if (cp <= 0x10FFFF) {
        if (size < 5)
            return 0;

        out[0] = (char)(0xF0 | (cp >> 18));
        out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[3] = (char)(0x80 | (cp & 0x3F));
        out[4] = '\0';
        return 4;
    }

    return 0;
}

/* ============================================================
 * MAPEO DE CARACTERES
 * ============================================================ */

static int codepoint_to_number(uint32_t cp)
{
    /*
     * Latín:
     * A-N = 1-14
     * Ñ   = 15
     * O-Z = 16-27
     */

    if (cp >= 'a' && cp <= 'z')
        cp -= ('a' - 'A');

    if (cp >= 'A' && cp <= 'N')
        return (int)(cp - 'A') + 1;

    if (cp == 0x00D1) /* Ñ */
        return 15;

    if (cp >= 'O' && cp <= 'Z')
        return (int)(cp - 'A') + 1;

    /*
     * Griego:
     * 28-51
     */

    switch (cp) {
        case 0x0391: return 28; /* Α */
        case 0x0392: return 29; /* Β */
        case 0x0393: return 30; /* Γ */
        case 0x0394: return 31; /* Δ */
        case 0x0395: return 32; /* Ε */
        case 0x0396: return 33; /* Ζ */
        case 0x0397: return 34; /* Η */
        case 0x0398: return 35; /* Θ */
        case 0x0399: return 36; /* Ι */
        case 0x039A: return 37; /* Κ */
        case 0x039B: return 38; /* Λ */
        case 0x039C: return 39; /* Μ */
        case 0x039D: return 40; /* Ν */
        case 0x039E: return 41; /* Ξ */
        case 0x039F: return 42; /* Ο */
        case 0x03A0: return 43; /* Π */
        case 0x03A1: return 44; /* Ρ */
        case 0x03A3: return 45; /* Σ */
        case 0x03A4: return 46; /* Τ */
        case 0x03A5: return 47; /* Υ */
        case 0x03A6: return 48; /* Φ */
        case 0x03A7: return 49; /* Χ */
        case 0x03A8: return 50; /* Ψ */
        case 0x03A9: return 51; /* Ω */
        default:
            break;
    }

    /*
     * Cirílico:
     * 52-84
     */

    switch (cp) {
        case 0x0410: return 52; /* А */
        case 0x0411: return 53; /* Б */
        case 0x0412: return 54; /* В */
        case 0x0413: return 55; /* Г */
        case 0x0414: return 56; /* Д */
        case 0x0415: return 57; /* Е */
        case 0x0401: return 58; /* Ё */
        case 0x0416: return 59; /* Ж */
        case 0x0417: return 60; /* З */
        case 0x0418: return 61; /* И */
        case 0x0419: return 62; /* Й */
        case 0x041A: return 63; /* К */
        case 0x041B: return 64; /* Л */
        case 0x041C: return 65; /* М */
        case 0x041D: return 66; /* Н */
        case 0x041E: return 67; /* О */
        case 0x041F: return 68; /* П */
        case 0x0420: return 69; /* Р */
        case 0x0421: return 70; /* С */
        case 0x0422: return 71; /* Т */
        case 0x0423: return 72; /* У */
        case 0x0424: return 73; /* Ф */
        case 0x0425: return 74; /* Х */
        case 0x0426: return 75; /* Ц */
        case 0x0427: return 76; /* Ч */
        case 0x0428: return 77; /* Ш */
        case 0x0429: return 78; /* Щ */
        case 0x042A: return 79; /* Ъ */
        case 0x042B: return 80; /* Ы */
        case 0x042C: return 81; /* Ь */
        case 0x042D: return 82; /* Э */
        case 0x042E: return 83; /* Ю */
        case 0x042F: return 84; /* Я */
        default:
            break;
    }

    return -1;
}

static uint32_t number_to_codepoint(int number)
{
    if (number >= 1 && number <= 14)
        return (uint32_t)('A' + number - 1);

    if (number == 15)
        return 0x00D1;

    if (number >= 16 && number <= 27)
        return (uint32_t)('A' + number - 1);

    switch (number) {
        case 28: return 0x0391;
        case 29: return 0x0392;
        case 30: return 0x0393;
        case 31: return 0x0394;
        case 32: return 0x0395;
