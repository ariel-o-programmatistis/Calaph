/*
 * CALAPH
 * Sistema de escritura y conversión de texto
 *
 * Funciones:
 *   1. Texto ordinario -> Calaph
 *   2. Calaph -> texto ordinario
 *
 * No contiene funciones de Binary, Hexadecimal ni Morse.
 *
 * Compilación:
 *   gcc -std=c99 -Wall -Wextra -Wpedantic -O2 calaph -o calaph
 */

