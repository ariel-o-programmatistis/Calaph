}

/* ============================================================
 * UTF-8
 * ============================================================ */

static size_t utf8_decode_one(const unsigned char *s, size_t remaining,
                              uint32_t *codepoint)
{
    if (s == NULL || codepoint == NULL || remaining == 0)
        return 0;

    unsigned char c = s[0];

    if (c < 0x80) {
        *codepoint = c;
        return 1;
    }

    if ((c & 0xE0) == 0xC0) {
        if (remaining < 2)
            return 0;

        unsigned char c1 = s[1];

        if ((c1 & 0xC0) != 0x80)
            return 0;

        uint32_t cp =
            ((uint32_t)(c & 0x1F) << 6) |
            (uint32_t)(c1 & 0x3F);

        if (cp < 0x80)
            return 0;

        *codepoint = cp;
        return 2;
    }

    if ((c & 0xF0) == 0xE0) {
        if (remaining < 3)
            return 0;

        unsigned char c1 = s[1];
        unsigned char c2 = s[2];

        if ((c1 & 0xC0) != 0x80 ||
            (c2 & 0xC0) != 0x80)
            return 0;

        uint32_t cp =
            ((uint32_t)(c & 0x0F) << 12) |
            ((uint32_t)(c1 & 0x3F) << 6) |
            (uint32_t)(c2 & 0x3F);

        if (cp < 0x800)
            return 0;

        if (cp >= 0xD800 && cp <= 0xDFFF)
            return 0;

        *codepoint = cp;
        return 3;
    }

    if ((c & 0xF8) == 0xF0) {
        if (remaining < 4)
            return 0;

        unsigned char c1 = s[1];
        unsigned char c2 = s[2];
        unsigned char c3 = s[3];

        if ((c1 & 0xC0) != 0x80 ||
            (c2 & 0xC0) != 0x80 ||
            (c3 & 0xC0) != 0x80)
            return 0;

        uint32_t cp =
            ((uint32_t)(c & 0x07) << 18) |
            ((uint32_t)(c1 & 0x3F) << 12) |
            ((uint32_t)(c2 & 0x3F) << 6) |
            (uint32_t)(c3 & 0x3F);

        if (cp < 0x10000 || cp > 0x10FFFF)
            return 0;

        *codepoint = cp;
        return 4;
    }

    return 0;
}

static size_t utf8_encode_one(uint32_t cp, char *out, size_t capacity)
{
    if (out == NULL)
        return 0;

    if (cp <= 0x7F) {
        if (capacity < 1)
            return 0;

        out[0] = (char)cp;
        return 1;
    }

    if (cp <= 0x7FF) {
        if (capacity < 2)
            return 0;

        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        return 2;
    }

    if (cp >= 0xD800 && cp <= 0xDFFF)
        return 0;

    if (cp <= 0xFFFF) {
        if (capacity < 3)
            return 0;

        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        return 3;
    }

    if (cp <= 0x10FFFF) {
        if (capacity < 4)
            return 0;

        out[0] = (char)(0xF0 | (cp >> 18));
        out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[3] = (char)(0x80 | (cp & 0x3F));
        return 4;
    }

    return 0;
}

/* ============================================================
 * MAPEO DE CARACTERES
 *
 * LATÍN:
 * A-N = 1-14
 * Ñ   = 15
 * O-Z = 16-27
 *
 * GRIEGO:
 * 28-51
 *
 * CIRÍLICO:
 * 52-84
 * ============================================================ */

static int codepoint_to_number(uint32_t cp)
{
    /* ASCII latino */

    if (cp >= 'a' && cp <= 'z')
        cp -= ('a' - 'A');

    if (cp >= 'A' && cp <= 'N')
        return (int)(cp - 'A') + 1;

    if (cp == 0xD1 || cp == 0xF1)
        return 15;

    if (cp >= 'O' && cp <= 'Z')
        return (int)(cp - 'O') + 16;

    /*
     * Ñ en UTF-8 ya llega decodificada como U+00D1.
     */

    if (cp == 0x00D1 || cp == 0x00F1)
        return 15;

    /* Griego mayúsculas */
    switch (cp) {
        case 0x0391: return 28; /* Α */
        case 0x0392: return 29; /* Β */
        case 0x0393: return 30; /* Γ */
        case 0x0394: return 31; /* Δ */
        case 0x0395: return 32; /* Ε */
        case 0x0396: return 33; /* Ζ */
        case 0x0397: return 34; /* Η */
        case 0x0398: return 35; /* Θ */
        case 0x0399: return 36; /* Ι */
        case 0x039A: return 37; /* Κ */
        case 0x039B: return 38; /* Λ */
        case 0x039C: return 39; /* Μ */
        case 0x039D: return 40; /* Ν */
        case 0x039E: return 41; /* Ξ */
        case 0x039F: return 42; /* Ο */
        case 0x03A0: return 43; /* Π */
        case 0x03A1: return 44; /* Ρ */
        case 0x03A3: return 45; /* Σ */
        case 0x03A4: return 46; /* Τ */
        case 0x03A5: return 47; /* Υ */
        case 0x03A6: return 48; /* Φ */
        case 0x03A7: return 49; /* Χ */
        case 0x03A8: return 50; /* Ψ */
        case 0x03A9: return 51; /* Ω */
    }

    /* Griego minúsculas */

    switch (cp) {
        case 0x03B1: return 28; /* α */
        case 0x03B2: return 29; /* β */
        case 0x03B3: return 30; /* γ */
        case 0x03B4: return 31; /* δ */
        case 0x03B5: return 32; /* ε */
        case 0x03B6: return 33; /* ζ */
        case 0x03B7: return 34; /* η */
