/* ============================================================
 * LOGO / MENÚ PRINCIPAL
 * ============================================================ */

static void print_logo(void)
{
    printf("\n");
    printf("CALAPH\n");
    printf("\n");
}

int main(void)
{
    char input[INPUT_SIZE];

    for (;;) {
        print_logo();

        printf("1. Work with Text\n");
        printf("2. Work with Numbers\n");
        printf("0. Exit\n\n");
        printf("> ");

        read_line(input, sizeof(input));

        if (strcmp(input, "0") == 0)
            break;

        if (strcmp(input, "1") == 0) {
