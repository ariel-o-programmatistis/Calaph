/* ============================================================
 * TEXT MENU
 * ============================================================ */

static void text_menu(void)
{
    char input[INPUT_MAX];
    char output[OUTPUT_MAX];
    int option;

    for (;;) {
        header("WORK WITH TEXT");

        printf("  1. Encrypt ordinary text -> Calaph\n");
        printf("  2. Decrypt Calaph -> ordinary text\n");
        printf("  0. Back\n\n");

        if (!get_input(
                "> ",
                input,
                sizeof(input)))
        {
            return;
        }

        if (!parse_menu_number(
                input,
                &option))
        {
            printf(
                "%sInvalid input.%s\n",
                C_RED,
                C_RESET
            );
            continue;
        }

        if (option == 0)
            return;

        if (option == 1) {
            if (!get_input(
                    "Enter ordinary text: > ",
                    input,
                    sizeof(input)))
            {
                continue;
            }

            if (!text_to_calaph(
                    input,
                    output,
                    sizeof(output)))
            {
                printf(
                    "%sUnsupported character or output too large.%s\n",
                    C_RED,
                    C_RESET
                );
            } else {
                show_result(
                    "Calaph:",
                    output
                );
            }

        } else if (option == 2) {
            if (!get_input(
                    "Enter Calaph: > ",
                    input,
                    sizeof(input)))
            {
                continue;
            }

            if (!calaph_to_text(
                    input,
                    output,
                    sizeof(output)))
            {
                printf(
                    "%sInvalid Calaph expression or unsupported character.%s\n",
                    C_RED,
                    C_RESET
                );
            } else {
                show_result(
                    "Text:",
                    output
                );
            }

        } else {
            printf(
                "%sInvalid option.%s\n",
                C_RED,
                C_RESET
            );
        }
    }
}

/* ============================================================
 * CODE MENU
 * ============================================================ */

static void code_menu(void)
{
    char input[INPUT_MAX];
    char output[OUTPUT_MAX];
    int option;

    for (;;) {
        header("WORK WITH CODES");

        printf("  1. Calaph -> Binary\n");
        printf("  2. Binary -> Calaph\n");
        printf("  3. Calaph -> Hexadecimal\n");
        printf("  4. Hexadecimal -> Calaph\n");
        printf("  5. Calaph -> Morse (Latin A-Z)\n");
        printf("  6. Morse -> Calaph (Latin A-Z)\n");
        printf("  0. Back\n\n");

        if (!get_input(
                "> ",
                input,
                sizeof(input)))
        {
            return;
        }

        if (!parse_menu_number(
                input,
                &option))
        {
            printf(
                "%sInvalid input.%s\n",
                C_RED,
                C_RESET
            );
            continue;
        }

        if (option == 0)
            return;

        if (!get_input(
                "Enter code: > ",
                input,
                sizeof(input)))
        {
            continue;
        }

        switch (option) {
            case 1:
                if (calaph_to_binary(
                        input,
                        output,
                        sizeof(output)))
                {
                    show_result(
                        "Binary:",
                        output
                    );
                } else {
                    printf(
                        "%sInvalid Calaph or value outside byte range.%s\n",
                        C_RED,
                        C_RESET
                    );
                }
                break;

            case 2:
                if (binary_to_calaph(
                        input,
                        output,
                        sizeof(output)))
                {
                    show_result(
                        "Calaph:",
                        output
                    );
                } else {
                    printf(
                        "%sInvalid binary: use groups of 8 bits.%s\n",
                        C_RED,
                        C_RESET
                    );
                }
                break;

            case 3:
                if (calaph_to_hex(
                        input,
                        output,
                        sizeof(output)))
                {
                    show_result(
                        "Hexadecimal:",
                        output
                    );
                } else {
                    printf(
                        "%sInvalid Calaph or value outside byte range.%s\n",
                        C_RED,
                        C_RESET
                    );
                }
                break;

            case 4:
                if (hex_to_calaph(
                        input,
                        output,
                        sizeof(output)))
                {
                    show_result(
                        "Calaph:",
                        output
                    );
                } else {
                    printf(
                        "%sInvalid hexadecimal: use pairs of digits.%s\n",
                        C_RED,
                        C_RESET
                    );
                }
                break;

            case 5:
                if (calaph_to_morse(
                        input,
                        output,
                        sizeof(output)))
                {
                    show_result(
                        "Morse:",
                        output
                    );
                } else {
                    printf(
                        "%sMorse conversion currently supports Latin A-Z and spaces only.%s\n",
                        C_RED,
                        C_RESET
                    );
                }
                break;

            case 6:
                if (morse_to_calaph(
                        input,
                        output,
                        sizeof(output)))
                {
                    show_result(
                        "Calaph:",
                        output
                    );
                } else {
                    printf(
                        "%sInvalid Morse input.%s\n",
                        C_RED,
                        C_RESET
                    );
                }
                break;

            default:
                printf(
                    "%sInvalid option.%s\n",
                    C_RED,
                    C_RESET
                );
                break;
        }
    }
}

