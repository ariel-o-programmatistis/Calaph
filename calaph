        case 78: return 0x0429;
        case 79: return 0x042A;
        case 80: return 0x042B;
        case 81: return 0x042C;
        case 82: return 0x042D;
        case 83: return 0x042E;
        case 84: return 0x042F;

        default:
            return 0;
    }
}

/* ============================================================
 * PARSER NUMÉRICO DE CALAPH
 * ============================================================ */

static int parse_symbol_expression(const char *expr, long long *result)
{
    if (expr == NULL || result == NULL || expr[0] == '\0')
        return 0;

    /*
     * Forma especial de 50.
     */
    if (strcmp(expr, ".,',,.") == 0) {
        *result = 50;
        return 1;
    }

    /*
     * Forma especial de 100.
     */
    if (strcmp(expr, ",,,.',,,.") == 0) {
        *result = 100;
        return 1;
    }

    if (strcmp(expr, "<>") == 0) {
        *result = 0;
        return 1;
    }

    long long value = 0;
    size_t len = strlen(expr);

    /*
     * Una expresión elemental solamente puede contener:
     * . y ,
     */

    for (size_t i = 0; i < len; ++i) {
        if (expr[i] != '.' && expr[i] != ',')
            return 0;
    }

    /*
     * Solo puntos:
     *
     * .    = 1
     * ..   = 2
     * ...  = 3
     */

    if (expr[0] == '.') {
        if (expr[1] == '\0') {
            *result = 1;
            return 1;
        }

        /*
         * Cuando aparece una coma después de un punto,
         * el primer punto funciona como resta de 1:
         *
         * .,  = 3 - 1 = 2
         * .,, = 3 + 3 - 1 = 5
         * .,,, = 8
         *
         * Los puntos posteriores vuelven a sumar 1.
         */

        int has_comma = 0;

        for (size_t i = 0; i < len; ++i) {
            if (expr[i] == ',') {
                has_comma = 1;
                break;
            }
        }

        if (!has_comma) {
            if (len > (size_t)LLONG_MAX) {
                return 0;
            }

            *result = (long long)len;
            return 1;
        }

        value = -1;

        for (size_t i = 1; i < len; ++i) {
            if (expr[i] == ',') {
                if (value > LLONG_MAX - 3)
                    return 0;

                value += 3;
            } else {
                if (value == LLONG_MAX)
                    return 0;

                value += 1;
            }
        }

        *result = value;
        return value >= 0;
    }

    /*
     * Comienza con coma:
     *
     * ,   = 3
     * ,,  = 6
     * ,,. = 7
     * ,,, = 9
     */

    value = 0;

    for (size_t i = 0; i < len; ++i) {
        if (expr[i] == ',') {
            if (value > LLONG_MAX - 3)
                return 0;

            value += 3;
        } else {
            if (value == LLONG_MAX)
                return 0;

            value += 1;
        }
    }

    *result = value;
    return 1;
}

static int evaluate_term(const char *term, long long *result)
{
    if (term == NULL || result == NULL || term[0] == '\0')
        return 0;

    char buffer[INPUT_SIZE];
    size_t len = strlen(term);

    if (len >= sizeof(buffer))
        return 0;

    strcpy(buffer, term);

    long long product = 1;
    char *part = strtok(buffer, "'");

    if (part == NULL)
        return 0;

    while (part != NULL) {
        long long value;

        if (!parse_symbol_expression(part, &value))
            return 0;

        if (value != 0 &&
            (product > LLONG_MAX / value)) {
            return 0;
        }

        product *= value;

        part = strtok(NULL, "'");
    }

    *result = product;
    return 1;
}

static int evaluate_calaph(const char *expression, long long *result)
{
    if (expression == NULL || result == NULL || expression[0] == '\0')
        return 0;

    /*
     * Las formas especiales son valores exactos.
     */

    if (strcmp(expression, ".,',,.") == 0) {
        *result = 50;
        return 1;
    }

    if (strcmp(expression, ",,,.',,,.") == 0) {
        *result = 100;
        return 1;
    }

    char buffer[INPUT_SIZE];
    size_t len = strlen(expression);

    if (len >= sizeof(buffer))
        return 0;

    strcpy(buffer, expression);

    long long total = 0;

    /*
     * El espacio simple representa suma.
     * Dos o más espacios no pertenecen a una expresión
     * numérica individual.
     */

    for (size_t i = 0; i < len; ++i) {
        if (buffer[i] == '\t' || buffer[i] == '\r' ||
            buffer[i] == '\n') {
            return 0;
        }
    }

    char *term = strtok(buffer, " ");

    if (term == NULL)
        return 0;

    while (term != NULL) {
        long long value;

        if (!evaluate_term(term, &value))
            return 0;

        if (value > 0 && total > LLONG_MAX - value)
            return 0;

        if (value < 0 && total < LLONG_MIN - value)
            return 0;

        total += value;

        term = strtok(NULL, " ");
    }

    *result = total;
    return 1;
}

/* ============================================================
 * CODIFICACIÓN DE ENTEROS
 * ============================================================ */

static int append_string(char *out, size_t out_size,
                         size_t *position, const char *text)
{
    if (out == NULL || position == NULL || text == NULL)
        return 0;

    size_t len = strlen(text);

    if (*position + len + 1 > out_size)
        return 0;

    memcpy(out + *position, text, len);
    *position += len;
    out[*position] = '\0';

    return 1;
}

static int encode_basic_integer(long long number,
                                char *out,
                                size_t out_size)
{
    if (out == NULL || out_size == 0)
        return 0;

    out[0] = '\0';

    if (number < 0)
        return 0;

    if (number == 0)
        return append_string(out, out_size,
                             &(size_t){0}, "<>");

    /*
     * 1-10:
     *
     * 1  .
     * 2  ..
     * 3  ...
     * 4  ....
     * ...
     * 10 ..........
     *
     * Para valores mayores usamos bloques de 10:
     * ,,,. = 10
     */

    size_t position = 0;

    while (number >= 10) {
        if (!append_string(out, out_size,
                           &position, ",,."))
            return 0;

        /*
         * ,,. = 6 + 1 = 7
         *
         * Por eso para representar 10 debemos usar
         * la forma canónica ,,,.
         */

        position -= 3;
        out[position] = '\0';

        if (!append_string(out, out_size,
                           &position, ",,,."))
            return 0;

        number -= 10;

        if (number > 0) {
            if (!append_string(out, out_size,
                               &position, " "))
                return 0;
        }
    }

    if (number > 0) {
        char remainder[32];

        if (number <= 3) {
            for (long long i = 0; i < number; ++i)
                remainder[i] = '.';

            remainder[number] = '\0';
        } else {
            /*
             * Formas canónicas de 4-9.
             *
             * 4 = ,.
             * 5 = .,, 
             * 6 = ,,
             * 7 = ,,. 
             * 8 = .,,,
             * 9 = ,,,
             */

            switch ((int)number) {
                case 4:
                    strcpy(remainder, ",.");
                    break;

                case 5:
                    strcpy(remainder, ".,,");
                    break;

                case 6:
                    strcpy(remainder, ",,");
                    break;

                case 7:
                    strcpy(remainder, ",,.");
                    break;

                case 8:
                    strcpy(remainder, ".,,,");
                    break;

                case 9:
                    strcpy(remainder, ",,,");
                    break;

                default:
                    return 0;
            }
        }

        if (!append_string(out, out_size,
                           &position, remainder))
            return 0;
    }

    return 1;
}

static int encode_integer(long long number,
                          char *out,
                          size_t out_size)
{
    if (out == NULL || out_size == 0)
        return 0;

    out[0] = '\0';

    if (number < 0)
        return 0;

    /*
     * Formas especiales.
     */

    if (number == 50)
        return append_string(out, out_size,
                             &(size_t){0}, ".,',,.");

    if (number == 100)
        return append_string(out, out_size,
                             &(size_t){0}, ",,,.',,,.");

    /*
     * Cualquier otro número positivo.
     */

    if (number == 0)
        return append_string(out, out_size,
                             &(size_t){0}, "<>");

    size_t position = 0;

    while (number >= 10) {
        if (!append_string(out, out_size,
                           &position, ",,,."))
            return 0;

        number -= 10;

        if (number > 0) {
            if (!append_string(out, out_size,
                               &position, " "))
                return 0;
        }
    }

    if (number > 0) {
        char remainder[32];

        switch ((int)number) {
            case 1:
                strcpy(remainder, ".");
                break;

            case 2:
                strcpy(remainder, "..");
                break;

            case 3:
                strcpy(remainder, "...");
                break;

            case 4:
                strcpy(remainder, ",.");
                break;

            case 5:
                strcpy(remainder, ".,,");
                break;

            case 6:
                strcpy(remainder, ",,");
                break;

            case 7:
                strcpy(remainder, ",,.");
                break;

            case 8:
                strcpy(remainder, ".,,,");
                break;

            case 9:
                strcpy(remainder, ",,,");
                break;

            default:
                return 0;
        }

        if (!append_string(out, out_size,
                           &position, remainder))
            return 0;
    }

    return 1;
}

/* ============================================================
 * TEXTO -> CALAPH
 * ============================================================ */

static int text_to_calaph(const char *text,
                           char *output,
                           size_t output_size)
{
    if (text == NULL || output == NULL || output_size == 0)
        return 0;

    output[0] = '\0';

    size_t position = 0;
    size_t len = strlen(text);

    for (size_t i = 0; i < len;) {
        unsigned char c = (unsigned char)text[i];

        /*
         * Espacio ordinario.
         */
        if (c == ' ') {
            if (!append_string(output, output_size,
                               &position, "/"))
                return 0;

            ++i;
            continue;
        }

        uint32_t cp;
        int bytes = utf8_decode(
            (const unsigned char *)&text[i], &cp);

        if (bytes <= 0)
            return 0;

        int number = codepoint_to_number(cp);

        if (number < 1 || number > 84)
            return 0;

        char encoded[128];

        if (!encode_integer(number,
                            encoded,
                            sizeof(encoded)))
            return 0;

        /*
         * Dos espacios separan caracteres.
         */

        if (position > 0) {
            if (!append_string(output, output_size,
                               &position, "  "))
                return 0;
        }

        if (!append_string(output, output_size,
                           &position, encoded))
            return 0;

        i += (size_t)bytes;
    }

    return 1;
}

/* ============================================================
 * CALAPH -> TEXTO
 * ============================================================ */

static int calaph_to_text(const char *input,
                          char *output,
                          size_t output_size)
{
    if (input == NULL || output == NULL || output_size == 0)
        return 0;

    output[0] = '\0';

    size_t position = 0;
    size_t len = strlen(input);

    size_t start = 0;

    while (start < len) {
        /*
         * Espacio ordinario de texto.
         */
        if (input[start] == '/') {
            if (position + 1 >= output_size)
                return 0;

            output[position++] = ' ';
            output[position] = '\0';

            ++start;

            if (start < len && input[start] != ' ')
                continue;
        }

        /*
         * Saltamos espacios iniciales.
         */
        while (start < len && input[start] == ' ')
            ++start;

        if (start >= len)
            break;

        /*
         * Buscamos el siguiente separador de carácter:
         * dos o más espacios.
         */

        size_t end = start;
        size_t spaces = 0;

        while (end < len) {
            if (input[end] == '/') {
                /*
                 * Un / dentro de una expresión no es válido.
                 */
                break;
            }

            if (input[end] == ' ') {
                size_t p = end;

                while (p < len && input[p] == ' ')
                    ++p;

                spaces = p - end;

                if (spaces >= 2)
                    break;

                /*
                 * Un espacio simple pertenece a una suma.
                 */
                end = p;
                continue;
            }

            ++end;
        }

        if (end == start)
            return 0;

        size_t expression_len = end - start;

        if (expression_len >= INPUT_SIZE)
            return 0;

        char expression[INPUT_SIZE];

        memcpy(expression,
               input + start,
               expression_len);

        expression[expression_len] = '\0';

        /*
         * El fragmento no puede terminar en un espacio.
         */
        while (expression_len > 0 &&
               expression[expression_len - 1] == ' ') {
            expression[--expression_len] = '\0';
        }

        if (expression_len == 0)
            return 0;

        long long value;

        if (!evaluate_calaph(expression, &value))
            return 0;

        /*
         * Los caracteres del alfabeto de Calaph son 1-84.
         */
        if (value < 1 || value > 84)
            return 0;

        uint32_t cp = number_to_codepoint((int)value);

        if (cp == 0)
            return 0;

        char utf8[8];

        int bytes = utf8_encode(cp, utf8, sizeof(utf8));

        if (bytes <= 0)
            return 0;

        if (position + (size_t)bytes >= output_size)
            return 0;

        memcpy(output + position, utf8, (size_t)bytes);
        position += (size_t)bytes;
        output[position] = '\0';

        /*
         * Si encontramos '/', procesamos el espacio.
         */
        size_t p = end;

        while (p < len && input[p] == ' ')
            ++p;

        if (p < len && input[p] == '/') {
            if (position + 1 >= output_size)
                return 0;

            output[position++] = ' ';
            output[position] = '\0';

            start = p + 1;
        } else {
            start = p;
        }
    }

    return 1;
}

/* ============================================================
 * NÚMEROS
 * ============================================================ */

static void work_with_numbers(void)
{
    char input[INPUT_SIZE];
    char output[OUTPUT_SIZE];

    for (;;) {
        printf("\n");
        printf("WORK WITH NUMBERS\n\n");
        printf("1. Encrypt number -> Calaph\n");
        printf("2. Decrypt Calaph -> number\n");
        printf("0. Back\n\n");
        printf("> ");

        read_line(input, sizeof(input));

        if (strcmp(input, "0") == 0)
            return;

        if (strcmp(input, "1") == 0) {
            printf("\nEnter a non-negative integer:\n> ");

            read_line(input, sizeof(input));

            if (input[0] == '\0') {
                printf("\nInvalid number.\n");
                continue;
            }

            char *endptr = NULL;
            long long number = strtoll(input, &endptr, 10);

            if (endptr == input || *endptr != '\0' ||
                number < 0) {
                printf("\nInvalid number.\n");
                continue;
            }

            if (!encode_integer(number,
                                output,
                                sizeof(output))) {
                printf("\nNumber cannot be represented.\n");
                continue;
            }

            printf("\nCalaph:\n%s\n", output);
        }

        else if (strcmp(input, "2") == 0) {
            printf("\nEnter a Calaph numerical expression:\n> ");

            read_line(input, sizeof(input));

            long long number;

            if (!evaluate_calaph(input, &number)) {
                printf("\nInvalid Calaph expression.\n");
                continue;
            }

            printf("\nNumber:\n%lld\n", number);
        }

        else {
            printf("\nInvalid option.\n");
        }
    }
}

