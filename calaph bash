    printf "${BOLD}${WHITE}  OUTPUT${RESET}\n"
    line

    printf "${GREEN}  "

    read -ra tokens <<< "$input"

    local token
    local value
    local character

    for token in "${tokens[@]}"; do

        if [[ "$token" == "/" ]]; then

            printf ' '

        else

            value=$(evaluate_calaph "$token")

            if [[ $? -ne 0 ]]; then

                printf '?'

            else

                character=$(number_to_character "$value")
                printf '%s' "$character"
            fi
        fi
    done

    printf "${RESET}\n"
}

