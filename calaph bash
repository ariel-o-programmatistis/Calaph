# ============================================================
# TEXT -> CALAPH
# ============================================================

text_to_calaph() {

    header "TEXT" "ENCRYPT"

    printf "${BOLD}${WHITE}  INPUT${RESET}\n"
    line

    printf '  Enter ordinary text:\n'
    printf "${GREEN}  > ${RESET}"

    IFS= read -r input

    printf '\n'

    printf "${BOLD}${WHITE}  PROCESSING${RESET}\n"
    line

    printf '\n'

    local output=""
    local i
    local char
    local number
    local encoded

    for ((i=0; i<${#input}; i++)); do

        char="${input:i:1}"

        if [[ "$char" == " " ]]; then

            printf "${DIM}  [SPACE]${RESET}\n"
            output+=" / "
            continue
        fi

        number=$(character_to_number "$char")

        if [[ $? -ne 0 ]]; then

            printf "  %s ${RED}→ unsupported${RESET}\n" "$char"
            output+=" ? "
            continue
        fi

        encoded=$(encode_integer "$number")

        printf "  %s ${CYAN}→${RESET} %s\n" \
            "$char" "$encoded"

        if [[ -n "$output" && "$output" != *" / " ]]; then
            output+=" "
        fi

        output+="$encoded"
    done

    printf '\n'

    printf "${BOLD}${WHITE}  OUTPUT${RESET}\n"
    line

    printf "${GREEN}  %s${RESET}\n" "$output"
}

