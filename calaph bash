# ============================================================
# CALAPH PRIMITIVES
# ============================================================

primitive_for_number() {
    case "$1" in
        0)  printf '<>' ;;
        1)  printf '.' ;;
        2)  printf '.,' ;;
        3)  printf ',' ;;
        4)  printf ',.' ;;
        5)  printf '.,,' ;;
        6)  printf ',,' ;;
        7)  printf ',,.' ;;
        8)  printf '.,,,' ;;
        9)  printf ',,,' ;;
        10) printf ',,,.' ;;
        *)  return 1 ;;
    esac
}

# ============================================================
# CALAPH PARSER
# ============================================================

parse_primitive() {
    local s="$1"

    if [[ "$s" == "<>" ]]; then
        printf '0'
        return 0
    fi

    local value=0
    local char

    for ((i=0; i<${#s}; i++)); do

        char="${s:i:1}"

        case "$char" in
            '.')
                ((value+=1))
                ;;
            ',')
                ((value+=3))
                ;;
            *)
                return 1
                ;;
        esac

    done

    printf '%d' "$value"
}

parse_product() {
    local s="$1"

    local apostrophe_count
    apostrophe_count=$(grep -o "'" <<< "$s" | wc -l)

    if ((apostrophe_count > 1)); then
        return 1
    fi

    if [[ "$s" != *"'"* ]]; then
        parse_primitive "$s"
        return $?
    fi

    local left="${s%%\'*}"
    local right="${s#*\'"

    [[ -z "$left" || -z "$right" ]] && return 1

    local left_value
    local right_value

    left_value=$(parse_primitive "$left") || return 1
    right_value=$(parse_primitive "$right") || return 1

    printf '%d' "$((left_value * right_value))"
}

evaluate_calaph() {
    local expression="$1"
    local total=0
    local token
    local value

    read -ra tokens <<< "$expression"

    for token in "${tokens[@]}"; do

        value=$(parse_product "$token") || return 1

        ((total+=value))

    done

    printf '%d' "$total"
}

# ============================================================
# INTEGER -> CALAPH
# ============================================================

encode_integer() {
    local value="$1"

    if ((value == 0)); then
        printf '<>'
        return
    fi

    local output=""
    local hundreds
    local remainder
    local part

    while ((value >= 50)); do

        if ((value >= 100)); then

            hundreds=$((value / 100))

            if [[ -n "$output" ]]; then
                output+=" "
            fi

            if ((hundreds == 1)); then

                output+=",,,.',,,."

            else

                part=$(encode_integer "$hundreds")

                output+="${part}',,,."
            fi

            value=$((value - hundreds * 100))

        else

            if [[ -n "$output" ]]; then
                output+=" "
            fi

            # Preferred representation for 50
            output+=".,',,."

            value=$((value - 50))
        fi
    done

    if ((value > 0)); then

        if [[ -n "$output" ]]; then
            output+=" "
        fi

        if ((value <= 10)); then

            part=$(primitive_for_number "$value")
            output+="$part"

        else

            local threes=$((value / 3))
            local remainder=$((value % 3))

            for ((i=0; i<threes; i++)); do
                output+=","
            done

            if ((remainder == 1)); then
                output+="."
            elif ((remainder == 2)); then
                output+=".,"
            fi
        fi
    fi

    printf '%s' "$output"
}

