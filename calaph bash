#!/usr/bin/env bash

# ============================================================
#                            CALAPH
#              SYMBOLIC CONVERSION SYSTEM
# ============================================================

# Supported conversions:
#
#     Calaph <-> Morse
#     Calaph <-> Hexadecimal
#     Calaph <-> Binary
#
# Calaph numerical primitives:
#
#     .      = 1
#     ,      = 3
#     <>     = 0
#
# Arithmetic:
#
#     '      = multiplication
#     space  = addition
#
# Decimal notation:
#
#     |      = decimal separator
#     \      = separator between decimal digits
#
# Examples:
#
#     .       = 1
#     ,.      = 4
#     ,',     = 9
#     .,,     = 5
#     .,',,.  = 50
#
#     ,|.\,.  = 3.14
#     <>      = 0


# ============================================================
#                         TERMINAL COLORS
# ============================================================

RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
BLUE='\033[34m'
MAGENTA='\033[35m'
WHITE='\033[37m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'


# ============================================================
#                         GENERAL UTILITIES
# ============================================================

clear_screen() {
    printf '\033[2J\033[H'
}

pause_program() {
    printf "\n${DIM}Press ENTER to continue...${RESET}"
    read -r
}

trim_newline() {
    local value="$1"
    value="${value//$'\r'/}"
    value="${value//$'\n'/}"
    printf '%s' "$value"
}


# ============================================================
#                       CALAPH NUMBER SYSTEM
# ============================================================

parse_primitive() {

    local str="$1"
    local value=0
    local char

    if [[ "$str" == "<>" ]]; then
        echo 0
        return
    fi

    while [[ -n "$str" ]]; do

        char="${str:0:1}"
        str="${str:1}"

        case "$char" in

            ".")
                ((value += 1))
                ;;

            ",")
                ((value += 3))
                ;;

            *)
                echo "-1"
                return
                ;;

        esac
    done

    echo "$value"
}


# ============================================================
#                      MULTIPLICATION PARSER
# ============================================================

parse_product() {

    local str="$1"
    local left
    local right
    local a
    local b

    if [[ "$str" != *"'"* ]]; then
        parse_primitive "$str"
        return
    fi

    # Only one multiplication operator is valid.

    if [[ "$str" == *"'"*"'"* ]]; then
        echo "-1"
        return
    fi

    left="${str%%\'*}"
    right="${str#*\'*}"

    if [[ -z "$left" || -z "$right" ]]; then
        echo "-1"
        return
    fi

    a=$(parse_primitive "$left")
    b=$(parse_primitive "$right")

    if (( a < 0 || b < 0 )); then
        echo "-1"
        return
    fi

    echo $((a * b))
}


# ============================================================
#                    FULL CALAPH EXPRESSION
# ============================================================

evaluate_calaph() {

    local input="$1"
    local token
    local value
    local total=0

    read -ra tokens <<< "$input"

    for token in "${tokens[@]}"; do

        value=$(parse_product "$token")

        if (( value < 0 )); then
            echo "-1"
            return
        fi

        ((total += value))
    done

    echo "$total"
}


# ============================================================
#                   INTEGER -> CALAPH
# ============================================================

primitive_for_number() {

    case "$1" in

        0)  echo "<>" ;;
        1)  echo "." ;;
        2)  echo ".," ;;
        3)  echo "," ;;
        4)  echo ",." ;;
        5)  echo ".,," ;;
        6)  echo ",," ;;
        7)  echo ",,." ;;
        8)  echo ".,,," ;;
        9)  echo ",,," ;;
        10) echo ",,,." ;;

        *)
            return 1
            ;;

    esac
}


encode_integer() {

    local value="$1"
    local remaining
    local multiplier
    local first=1
    local output=""

    if (( value == 0 )); then
        echo "<>"
        return
    fi

    if (( value <= 10 )); then
        primitive_for_number "$value"
        return
    fi

    # Preferred representation for 50.

    if (( value == 50 )); then
        echo ".,',,."
        return
    fi

    # Multiplication by 10.

    if (( value >= 20 && value % 10 == 0 )); then

        multiplier=$((value / 10))

        if (( multiplier <= 10 )); then

            printf "%s'%s\n" \
                "$(primitive_for_number "$multiplier")" \
                "$(primitive_for_number 10)"

            return
        fi
    fi

    # Multiplication by 3.

    if (( value >= 12 && value % 3 == 0 )); then

        multiplier=$((value / 3))

        if (( multiplier <= 10 )); then

            printf "%s'%s\n" \
                "$(primitive_for_number "$multiplier")" \
                "$(primitive_for_number 3)"

            return
        fi
    fi

    # Fallback: sum of 3s and 1s.

    remaining="$value"

    while (( remaining >= 3 )); do

        if (( first == 0 )); then
            output+=" "
        fi

        output+=","

        remaining=$((remaining - 3))
        first=0
    done

    if (( remaining == 1 )); then

        if (( first == 0 )); then
            output+=" "
        fi

        output+="."
    fi

    echo "$output"
}


# ============================================================
#                         MORSE TABLE
# ============================================================

morse_encode() {

    case "${1^^}" in

        A) echo ".-" ;;
        B) echo "-..." ;;
        C) echo "-.-." ;;
        D) echo "-.." ;;
        E) echo "." ;;
        F) echo "..-." ;;
        G) echo "--." ;;
        H) echo "...." ;;
        I) echo ".." ;;
        J) echo ".---" ;;
        K) echo "-.-" ;;
        L) echo ".-.." ;;
        M) echo "--" ;;
        N) echo "-." ;;
        O) echo "---" ;;
        P) echo ".--." ;;
        Q) echo "--.-" ;;
        R) echo ".-." ;;
        S) echo "..." ;;
        T) echo "-" ;;
        U) echo "..-" ;;
        V) echo "...-" ;;
        W) echo ".--" ;;
        X) echo "-..-" ;;
        Y) echo "-.--" ;;
        Z) echo "--.." ;;

        0) echo "-----" ;;
        1) echo ".----" ;;
        2) echo "..---" ;;
        3) echo "...--" ;;
        4) echo "....-" ;;
        5) echo "....." ;;
        6) echo "-...." ;;
        7) echo "--..." ;;
        8) echo "---.." ;;
        9) echo "----." ;;

        ".") echo ".-.-.-" ;;
        ",") echo "--..--" ;;
        "?") echo "..--.." ;;
        "!") echo "-.-.--" ;;
        "/") echo "-..-." ;;
        "(") echo "-.--." ;;
        ")") echo "-.--.-" ;;
        "&") echo ".-..." ;;
        ":") echo "---..." ;;
        ";") echo "-.-.-." ;;
        "=") echo "-...-" ;;
        "+") echo ".-.-." ;;
        "-") echo "-....-" ;;
        "_") echo "..--.-" ;;
        '"') echo ".-..-." ;;
        "\$") echo "...-..-" ;;
        "@") echo ".--.-." ;;

        *)
            return 1
            ;;

    esac
}


morse_decode() {

    case "$1" in

        ".-") echo "A" ;;
        "-...") echo "B" ;;
        "-.-.") echo "C" ;;
        "-..") echo "D" ;;
        ".") echo "E" ;;
        "..-.") echo "F" ;;
        "--.") echo "G" ;;
        "....") echo "H" ;;
        "..") echo "I" ;;
        ".---") echo "J" ;;
        "-.-") echo "K" ;;
        ".-..") echo "L" ;;
        "--") echo "M" ;;
        "-.") echo "N" ;;
        "---") echo "O" ;;
        ".--.") echo "P" ;;
        "--.-") echo "Q" ;;
        ".-.") echo "R" ;;
        "...") echo "S" ;;
        "-") echo "T" ;;
        "..-") echo "U" ;;
        "...-") echo "V" ;;
        ".--") echo "W" ;;
        "-..-") echo "X" ;;
        "-.--") echo "Y" ;;
        "--..") echo "Z" ;;

        "-----") echo "0" ;;
        ".----") echo "1" ;;
        "..---") echo "2" ;;
        "...--") echo "3" ;;
        "....-") echo "4" ;;
        ".....") echo "5" ;;
        "-....") echo "6" ;;
        "--...") echo "7" ;;
        "---..") echo "8" ;;
        "----.") echo "9" ;;

        ".-.-.-") echo "." ;;
        "--..--") echo "," ;;
        "..--..") echo "?" ;;
        "-.-.--") echo "!" ;;
        "-..-.") echo "/" ;;
        "-.--.") echo "(" ;;
        "-.--.-") echo ")" ;;
        ".-...") echo "&" ;;
        "---...") echo ":" ;;
        "-.-.-.") echo ";" ;;
        "-...-") echo "=" ;;
        ".-.-.") echo "+" ;;
        "-....-") echo "-" ;;
        "..--.-") echo "_" ;;
        ".-..-.") echo '"' ;;
        "...-..-") echo '$' ;;
        ".--.-.") echo "@" ;;

        *)
            return 1
            ;;

    esac
}


# ============================================================
#                      CALAPH -> MORSE
# ============================================================

calaph_to_morse() {

    local input="$1"
    local token
    local value
    local character
    local morse
    local output=""
    local first=1

    read -ra tokens <<< "$input"

    for token in "${tokens[@]}"; do

        value=$(evaluate_calaph "$token")

        if (( value < 0 || value > 255 )); then
            printf "${RED}Invalid Calaph value.${RESET}\n"
            return
        fi

        character=$(printf "\\$(printf '%03o' "$value")")

        morse=$(morse_encode "$character")

        if [[ -z "$morse" ]]; then
            morse="[unsupported]"
        fi

        if (( first == 0 )); then
            output+=" "
        fi

        output+="$morse"
        first=0
    done

    printf "\n${CYAN}Morse:${RESET}\n\n%s\n" "$output"
}


# ============================================================
#                      MORSE -> CALAPH
# ============================================================

morse_to_calaph() {

    local input="$1"
    local word
    local code
    local character
    local value
    local encoded
    local first_word=1
    local first_char

    printf "\n${CYAN}Calaph:${RESET}\n\n"

    IFS='/' read -ra words <<< "$input"

    for word in "${words[@]}"; do

        if (( first_word == 0 )); then
            printf "  "
        fi

        first_word=0
        first_char=1

        read -ra codes <<< "$word"

        for code in "${codes[@]}"; do

            character=$(morse_decode "$code")

            if [[ -z "$character" ]]; then
                printf "${RED}<?>${RESET}"
                continue
            fi

            printf -v value '%d' "'$character"

            encoded=$(encode_integer "$value")

            if (( first_char == 0 )); then
                printf " "
            fi

            printf "%s" "$encoded"

            first_char=0
        done
    done

    printf "\n"
}


# ============================================================
#                      CALAPH -> HEX
# ============================================================

calaph_to_hex() {

    local input="$1"
    local token
    local value

    printf "\n${CYAN}Hexadecimal:${RESET}\n\n"

    read -ra tokens <<< "$input"

    for token in "${tokens[@]}"; do

        value=$(evaluate_calaph "$token")

        if (( value < 0 )); then
            printf "${RED}Invalid Calaph expression.${RESET}\n"
            return
        fi

        if (( value > 255 )); then
            printf "${RED}Value exceeds one byte: %d${RESET}\n" "$value"
            return
        fi

        printf "%02X" "$value"
    done

    printf "\n"
}


# ============================================================
#                      HEX -> CALAPH
# ============================================================

hex_to_calaph() {

    local input="$1"
    local clean=""
    local char
    local value
    local encoded

    for ((i = 0; i < ${#input}; i++)); do

        char="${input:i:1}"

        if [[ "$char" =~ [[:xdigit:]] ]]; then
            clean+="$char"

        elif [[ "$char" =~ [[:space:]] ]]; then
            continue

        else
            printf "${RED}Invalid hexadecimal data.${RESET}\n"
            return
        fi
    done

    if (( ${#clean} == 0 || ${#clean} % 2 != 0 )); then
        printf "${RED}Hexadecimal must contain complete bytes.${RESET}\n"
        return
    fi

    printf "\n${CYAN}Calaph:${RESET}\n\n"

    for ((i = 0; i < ${#clean}; i += 2)); do

        char="${clean:i:2}"

        value=$((16#$char))

        encoded=$(encode_integer "$value")

        if (( i > 0 )); then
            printf " "
        fi

        printf "%s" "$encoded"
    done

    printf "\n"
}


# ============================================================
#                      CALAPH -> BINARY
# ============================================================

calaph_to_binary() {

    local input="$1"
    local token
    local value

    printf "\n${CYAN}Binary:${RESET}\n\n"

    read -ra tokens <<< "$input"

    for token in "${tokens[@]}"; do

        value=$(evaluate_calaph "$token")

        if (( value < 0 )); then
            printf "${RED}Invalid Calaph expression.${RESET}\n"
            return
        fi

        if (( value > 255 )); then
            printf "${RED}Value exceeds one byte: %d${RESET}\n" "$value"
            return
        fi

        printf "%08d" "$(echo "obase=2; $value" | bc)"
    done

    printf "\n"
}


# ============================================================
#                      BINARY -> CALAPH
# ============================================================

binary_to_calaph() {

    local input="$1"
    local clean=""
    local char
    local value
    local encoded

    for ((i = 0; i < ${#input}; i++)); do

        char="${input:i:1}"

        if [[ "$char" == "0" || "$char" == "1" ]]; then
            clean+="$char"

        elif [[ "$char" =~ [[:space:]] ]]; then
            continue

        else
            printf "${RED}Invalid binary data.${RESET}\n"
            return
        fi
    done

    if (( ${#clean} == 0 || ${#clean} % 8 != 0 )); then
        printf "${RED}Binary must contain complete 8-bit bytes.${RESET}\n"
        return
    fi

    printf "\n${CYAN}Calaph:${RESET}\n\n"

    for ((i = 0; i < ${#clean}; i += 8)); do

        char="${clean:i:8}"

        value=$((2#$char))

        encoded=$(encode_integer "$value")

        if (( i > 0 )); then
            printf " "
        fi

        printf "%s" "$encoded"
    done

    printf "\n"
}


