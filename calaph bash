# ============================================================
# MORSE DECODING
# ============================================================

morse_decode_code() {

    case "$1" in

        .-) printf 'A' ;;
        -...) printf 'B' ;;
        -.-.) printf 'C' ;;
        -..) printf 'D' ;;
        .) printf 'E' ;;
        ..-.) printf 'F' ;;
        --.) printf 'G' ;;
        ....) printf 'H' ;;
        ..) printf 'I' ;;
        .---) printf 'J' ;;
        -.-) printf 'K' ;;
        .-..) printf 'L' ;;
        --) printf 'M' ;;
        -.) printf 'N' ;;
        ---) printf 'O' ;;
        .--.) printf 'P' ;;
        --.-) printf 'Q' ;;
        .-.) printf 'R' ;;
        ...) printf 'S' ;;
        -) printf 'T' ;;
        ..-) printf 'U' ;;
        ...-) printf 'V' ;;
        .--) printf 'W' ;;
        -..-) printf 'X' ;;
        -.--) printf 'Y' ;;
        --..) printf 'Z' ;;

        -----) printf '0' ;;
