# ============================================================
#                           MENU
# ============================================================

print_menu() {

    printf "${YELLOW}1.${RESET}  Calaph -> Morse\n"
    printf "${YELLOW}2.${RESET}  Morse -> Calaph\n"
    printf "${YELLOW}3.${RESET}  Calaph -> Hexadecimal\n"
    printf "${YELLOW}4.${RESET}  Hexadecimal -> Calaph\n"
    printf "${YELLOW}5.${RESET}  Calaph -> Binary\n"
    printf "${YELLOW}6.${RESET}  Binary -> Calaph\n"
    printf "${YELLOW}0.${RESET}  Exit\n"

    printf "\n"
}


# ============================================================
#                            MAIN
# ============================================================

while true; do

    clear_screen

    print_logo
    print_menu

    printf "${GREEN}Select:${RESET} "
    read -r choice

    case "$choice" in

        1)

            clear_screen
            print_logo

            printf "${GREEN}Enter Calaph:${RESET}\n> "
            read -r input

            calaph_to_morse "$input"

            pause_program
            ;;

        2)

            clear_screen
            print_logo

            printf "${GREEN}Enter Morse:${RESET}\n"
            printf "${DIM}Use spaces between characters and / between words.${RESET}\n> "
            read -r input

            morse_to_calaph "$input"

            pause_program
            ;;

        3)

            clear_screen
            print_logo

            printf "${GREEN}Enter Calaph:${RESET}\n> "
            read -r input

            calaph_to_hex "$input"

            pause_program
            ;;

        4)

            clear_screen
            print_logo

            printf "${GREEN}Enter hexadecimal:${RESET}\n> "
            read -r input

            hex_to_calaph "$input"

            pause_program
            ;;

        5)

            clear_screen
            print_logo

            printf "${GREEN}Enter Calaph:${RESET}\n> "
            read -r input

            calaph_to_binary "$input"

            pause_program
            ;;

        6)

            clear_screen
            print_logo

            printf "${GREEN}Enter binary:${RESET}\n> "
            read -r input

            binary_to_calaph "$input"

            pause_program
            ;;

        0)

            clear_screen

            printf "${CYAN}Calaph terminated.${RESET}\n"

            exit 0
            ;;

        *)

            printf "${RED}Invalid option.${RESET}\n"

            pause_program
            ;;

    esac

done
    esac
done
