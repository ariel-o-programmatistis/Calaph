        .....) printf '5' ;;
        -....) printf '6' ;;
        --...) printf '7' ;;
        ---..) printf '8' ;;
        ----.) printf '9' ;;

        *) printf '?' ;;
    esac
}

# ============================================================
# CALAPH -> MORSE
# ============================================================

calaph_to_morse() {

    header "CODES" "CALAPH → MORSE"

    printf "${BOLD}${WHITE}  INPUT${RESET}\n"
    line

    printf '  Enter Calaph:\n'
    printf "${GREEN}  > ${RESET}"

    IFS= read -r input

    printf '\n'

    printf "${BOLD}${WHITE}  MORSE OUTPUT${RESET}\n"
    line

    printf "${GREEN}  "

    read -ra tokens <<< "$input"

    local token
    local value
    local character
    local morse

    for token in "${tokens[@]}"; do

        if [[ "$token" == "/" ]]; then

            printf '/ '

        else

            value=$(evaluate_calaph "$token")

            if ((value >= 1 && value <= 26)); then

                character=$(number_to_character "$value")
                morse=$(morse_encode_char "$character")

                printf '%s ' "$morse"

            else

                printf '? '
            fi
        fi
    done

    printf "${RESET}\n"
}

