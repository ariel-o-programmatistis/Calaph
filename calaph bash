# ============================================================
# HEXADECIMAL -> CALAPH
# ============================================================

hex_to_calaph() {

    header "CODES" "HEXADECIMAL → CALAPH"

    printf "${BOLD}${WHITE}  INPUT${RESET}\n"
    line

    printf '  Enter hexadecimal:\n'
    printf "${GREEN}  > ${RESET}"

    IFS= read -r input

    printf '\n'

    printf "${BOLD}${WHITE}  CALAPH OUTPUT${RESET}\n"
    line

    printf "${GREEN}  "

    read -ra tokens <<< "$input"

    local token
    local value
    local encoded

    for token in "${tokens[@]}"; do

        if [[ ! "$token" =~ ^[0-9a-fA-F]+$ ]]; then

            printf '? '
            continue
        fi

        value=$((16#$token))

        if ((value > 255)); then

            printf '? '

        elif ((value == 32)); then

            printf '/ '

        else

            encoded=$(encode_integer "$value")
            printf '%s ' "$encoded"
        fi
    done

    printf "${RESET}\n"
}

