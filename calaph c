    line();

    printf(GREEN "  ");

    char *token = strtok(input, " \n");

    while (token != NULL) {

        char *end;

        long value = strtol(token, &end, 16);

        if (*end != '\0' ||
            value < 0 ||
            value > 255) {

            printf("? ");

        } else if (value == 0x20) {

            printf("/ ");

