    printf(BOLD WHITE "  CALAPH OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    char *token = strtok(input, " \n");

    while (token != NULL) {

        int valid = 1;
        int value = 0;

        if (strlen(token) != 8) {

            valid = 0;

        } else {

            for (int i = 0; i < 8; i++) {

                if (token[i] != '0' &&
                    token[i] != '1') {

                    valid = 0;
                    break;
                }

                value =
                    value * 2 +
                    (token[i] - '0');
            }
        }

        if (!valid) {

            printf("? ");

        } else if (value == 0x20) {

            printf("/ ");

        } else {

            char encoded[1024];

            encode_integer(
                value,
                encoded,
                sizeof(encoded)
            );

            printf("%s ", encoded);
        }

        token = strtok(NULL, " \n");
    }

    printf(RESET "\n");
}

