#define MORSE_COUNT (sizeof(morse_table) / sizeof(morse_table[0]))

const char *morse_encode_char(char c) {
    c = (char)toupper((unsigned char)c);

    for (size_t i = 0; i < MORSE_COUNT; i++) {
        if (morse_table[i].character == c)
            return morse_table[i].code;
    }

    return NULL;
}

char morse_decode_code(const char *code) {
    for (size_t i = 0; i < MORSE_COUNT; i++) {
        if (strcmp(morse_table[i].code, code) == 0)
            return morse_table[i].character;
    }

    return '?';
}

void text_to_morse(const char *input) {
    for (size_t i = 0; input[i] != '\0'; i++) {

        if (input[i] == ' ') {
            printf("/ ");
            continue;
        }

        const char *code = morse_encode_char(input[i]);

        if (code)
            printf("%s ", code);
        else
            printf("%c ", input[i]);
    }
}

void morse_to_text(const char *input) {
    char copy[16384];
    snprintf(copy, sizeof(copy), "%s", input);

    char *token = strtok(copy, " ");

    while (token) {

        if (strcmp(token, "/") == 0) {
            putchar(' ');
        } else {
            putchar(morse_decode_code(token));
        }

        token = strtok(NULL, " ");
    }
}

