    char *token = strtok(input, " \n");

    while (token != NULL) {

        if (strcmp(token, "/") == 0) {

            printf(" ");

        } else {

            int value = evaluate_calaph(token);

            if (value >= 0) {

                wchar_t character =
                    number_to_character(value);

                wprintf(L"%lc", character);

            } else {

                printf("?");
            }
        }

        token = strtok(NULL, " \n");
    }

    printf(RESET "\n");
}

/* ============================================================
   MORSE ENCODING
   ============================================================ */

const char *morse_encode_char(char c) {

    switch (toupper((unsigned char)c)) {

        case 'A': return ".-";
        case 'B': return "-...";
        case 'C': return "-.-.";
        case 'D': return "-..";
        case 'E': return ".";
        case 'F': return "..-.";
        case 'G': return "--.";
        case 'H': return "....";
        case 'I': return "..";
        case 'J': return ".---";
        case 'K': return "-.-";
        case 'L': return ".-..";
        case 'M': return "--";
        case 'N': return "-.";
        case 'O': return "---";
        case 'P': return ".--.";
        case 'Q': return "--.-";
        case 'R': return ".-.";
        case 'S': return "...";
        case 'T': return "-";
        case 'U': return "..-";
        case 'V': return "...-";
        case 'W': return ".--";
        case 'X': return "-..-";
        case 'Y': return "-.--";
        case 'Z': return "--..";

        case '0': return "-----";
        case '1': return ".----";
        case '2': return "..---";
        case '3': return "...--";
        case '4': return "....-";
        case '5': return ".....";
        case '6': return "-....";
        case '7': return "--...";
        case '8': return "---..";
        case '9': return "----.";

        default:
            return NULL;
    }
}

/* ============================================================
   MORSE DECODING
   ============================================================ */

char morse_decode_code(const char *code) {

    const char *codes[] = {

        ".-", "-...", "-.-.", "-..", ".", "..-.",
        "--.", "....", "..", ".---", "-.-", ".-..",
        "--", "-.", "---", ".--.", "--.-", ".-.",
        "...", "-", "..-", "...-", ".--", "-..-",
        "-.--", "--.."
    };

    for (int i = 0; i < 26; i++) {

        if (strcmp(code, codes[i]) == 0)
            return 'A' + i;
    }

    const char *digits[] = {

        "-----", ".----", "..---", "...--", "....-",
        ".....", "-....", "--...", "---..", "----."
    };

    for (int i = 0; i < 10; i++) {

        if (strcmp(code, digits[i]) == 0)
            return '0' + i;
    }

    return '?';
}

/* ============================================================
   CALAPH -> MORSE
   ============================================================ */

void calaph_to_morse(void) {

    char input[8192];

    header("CODES", "CALAPH → MORSE");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter Calaph:\n");
    printf(GREEN "  > " RESET);

    if (!fgets(input, sizeof(input), stdin))
        return;

    printf("\n");

    printf(BOLD WHITE "  MORSE OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    char *token = strtok(input, " \n");

    while (token != NULL) {

        if (strcmp(token, "/") == 0) {

            printf("/ ");

        } else {

            int value = evaluate_calaph(token);

            if (value >= 1 && value <= 26) {

                char c = 'A' + value - 1;

                const char *morse =
                    morse_encode_char(c);

                if (morse)
                    printf("%s ", morse);
                else
                    printf("? ");

            } else {

                printf("? ");
            }
        }

        token = strtok(NULL, " \n");
    }

    printf(RESET "\n");
}

