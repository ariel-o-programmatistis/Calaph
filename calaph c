void calaph_to_binary(void) {

    char input[INPUT_SIZE];

    header("CODES", "CALAPH → BINARY");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter Calaph:\n");
    printf(GREEN "  > " RESET);
    fflush(stdout);

    if (!read_line(input, sizeof(input)))
        return;

    printf("\n");

    printf(BOLD WHITE "  BINARY OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    char *token =
        strtok(input, " ");

    while (token != NULL) {

        if (strcmp(token, "/") == 0) {

            printf("00100000 ");

        } else {

            int value =
                evaluate_calaph(token);

            if (value >= 0 &&
                value <= 255) {

                for (int i = 7; i >= 0; i--)
                    printf(
                        "%d",
                        (value >> i) & 1
                    );

                printf(" ");

            } else {

                printf("???????? ");
            }
        }

        token = strtok(NULL, " ");
    }

    printf(RESET "\n");
}

/* ============================================================
   BINARY -> CALAPH
   ============================================================ */

void binary_to_calaph(void) {

    char input[INPUT_SIZE];

    header("CODES", "BINARY → CALAPH");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter binary:\n");
    printf(GREEN "  > " RESET);
    fflush(stdout);

    if (!read_line(input, sizeof(input)))
        return;

    printf("\n");

    printf(BOLD WHITE "  CALAPH OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    char *token =
        strtok(input, " ");

    while (token != NULL) {

        int valid = 1;
        int value = 0;

        if (strlen(token) != 8) {

            valid = 0;

        } else {

            for (int i = 0; i < 8; i++) {

                if (token[i] != '0' &&
                    token[i] != '1') {

                    valid = 0;
                    break;
                }

                value =
                    value * 2 +
                    (token[i] - '0');
            }
        }

        if (!valid) {

            printf("? ");

        } else if (value == 0x20) {

            printf("/ ");

        } else {

            char encoded[1024];

            encode_integer(
                value,
                encoded,
                sizeof(encoded)
            );

            printf("%s ", encoded);
        }

        token = strtok(NULL, " ");
    }

    printf(RESET "\n");
}

