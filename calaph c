/* ============================================================
                             MAIN
   ============================================================ */

int main(void)
{
    setlocale(LC_ALL, "");

    char input[8192];
    int choice;

    while (1) {

        clear_screen();

        print_logo();
        print_menu();

        printf("%sSelect:%s ", GREEN, RESET);

        if (scanf("%d", &choice) != 1) {

            while (getchar() != '\n')
                ;

            printf("%sInvalid option.%s\n",
                   RED, RESET);

            pause_program();
            continue;
        }

        getchar();

        if (choice == 0)
            break;

        clear_screen();
        print_logo();

        switch (choice) {

            case 1:

                printf(
                    "%sEnter Calaph:%s\n> ",
                    GREEN, RESET
                );

                fgets(input,
                      sizeof(input),
                      stdin);

                trim_newline(input);

                calaph_to_morse(input);

                pause_program();

                break;

            case 2:

                printf(
                    "%sEnter Morse:%s\n"
                    "%sUse spaces between characters and / between words.%s\n"
                    "> ",
                    GREEN,
                    RESET,
                    DIM,
                    RESET
                );

                fgets(input,
                      sizeof(input),
                      stdin);

                trim_newline(input);

                morse_to_calaph(input);

                pause_program();

                break;

            case 3:

                printf(
                    "%sEnter Calaph:%s\n> ",
                    GREEN,
                    RESET
                );

                fgets(input,
                      sizeof(input),
                      stdin);

                trim_newline(input);

                calaph_to_hex(input);

                pause_program();

                break;

            case 4:

                printf(
                    "%sEnter hexadecimal:%s\n> ",
                    GREEN,
                    RESET
                );

                fgets(input,
                      sizeof(input),
                      stdin);

                trim_newline(input);

                hex_to_calaph(input);

                pause_program();

                break;

            case 5:

                printf(
                    "%sEnter Calaph:%s\n> ",
                    GREEN,
                    RESET
                );

                fgets(input,
                      sizeof(input),
                      stdin);

                trim_newline(input);

                calaph_to_binary(input);

                pause_program();

                break;

            case 6:

                printf(
                    "%sEnter binary:%s\n> ",
                    GREEN,
                    RESET
                );

                fgets(input,
                      sizeof(input),
                      stdin);

                trim_newline(input);

                binary_to_calaph(input);

                pause_program();

                break;

            default:

                printf(
                    "%sInvalid option.%s\n",
                    RED,
                    RESET
                );

                pause_program();

                break;
        }
    }

    clear_screen();

    printf(
        "%sCalaph terminated.%s\n",
        CYAN,
        RESET
    );

    return 0;
}
