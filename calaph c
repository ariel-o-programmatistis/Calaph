/* ============================================================
   CALAPH PRIMITIVES
   ============================================================ */

const char *primitive_for_number(int n) {

    switch (n) {

        case 0:
            return "<>";

        case 1:
            return ".";

        case 2:
            return ".,";

        case 3:
            return ",";

        case 4:
            return ",.";

        case 5:
            return ".,,";

        case 6:
            return ",,";

        case 7:
            return ",,.";

        case 8:
            return ".,,,";

        case 9:
            return ",,,";

        case 10:
            return ",,,.";

        default:
            return NULL;
    }
}

/* ============================================================
   CALAPH PARSER
   ============================================================ */

int parse_primitive(const char *s) {

    if (strcmp(s, "<>") == 0)
        return 0;

    int value = 0;

    for (size_t i = 0; s[i] != '\0'; i++) {

        if (s[i] == '.')
            value += 1;

        else if (s[i] == ',')
            value += 3;

        else
            return -1;
    }

    return value;
}

int parse_product(const char *s) {

    char buffer[1024];

    strncpy(buffer, s, sizeof(buffer) - 1);
    buffer[sizeof(buffer) - 1] = '\0';

    char *apostrophe = strchr(buffer, '\'');

    if (!apostrophe)
        return parse_primitive(buffer);

    if (strchr(apostrophe + 1, '\''))
        return -1;

    *apostrophe = '\0';

    if (buffer[0] == '\0' || apostrophe[1] == '\0')
        return -1;

    int left = parse_primitive(buffer);
    int right = parse_primitive(apostrophe + 1);

    if (left < 0 || right < 0)
        return -1;

    return left * right;
}

int evaluate_calaph(const char *expression) {

    char buffer[4096];

    strncpy(buffer, expression, sizeof(buffer) - 1);
    buffer[sizeof(buffer) - 1] = '\0';

    int total = 0;

    char *token = strtok(buffer, " ");

    while (token != NULL) {

        int value = parse_product(token);

        if (value < 0)
            return -1;

        total += value;

        token = strtok(NULL, " ");
    }

    return total;
}

/* ============================================================
   INTEGER -> CALAPH
   ============================================================ */

void encode_integer(int value, char *output, size_t size) {

    if (value == 0) {
        snprintf(output, size, "<>");
        return;
    }

    output[0] = '\0';

    /*
       50 is represented using the preferred Calaph form:

       .,',,. = 50
    */

    while (value >= 50) {

        if (value >= 100) {

            int hundreds = value / 100;

            if (output[0] != '\0')
                strncat(output, " ",
                        size - strlen(output) - 1);

            /*
               100 = ,,,.' ,,,.
            */

            if (hundreds == 1) {

                strncat(output, ",,,.'", size - strlen(output) - 1);
                strncat(output, ",,,.", size - strlen(output) - 1);

            } else {

                char left[256];

                encode_integer(hundreds, left, sizeof(left));

                strncat(output, left,
                        size - strlen(output) - 1);

                strncat(output, "'",
                        size - strlen(output) - 1);

                strncat(output, ",,,.",
                        size - strlen(output) - 1);
            }

            value -= hundreds * 100;

        } else {

            if (output[0] != '\0')
                strncat(output, " ",
                        size - strlen(output) - 1);

            strncat(output, ".,',,.",
                    size - strlen(output) - 1);

            value -= 50;
        }
    }

    if (value > 0) {

        if (output[0] != '\0')
            strncat(output, " ",
                    size - strlen(output) - 1);

        if (value <= 10) {

            const char *p = primitive_for_number(value);

            if (p)
                strncat(output, p,
                        size - strlen(output) - 1);

        } else {

            int threes = value / 3;
            int remainder = value % 3;

            for (int i = 0; i < threes; i++) {

                strncat(output, ",",
                        size - strlen(output) - 1);
            }

            if (remainder == 1) {

                strncat(output, ".",
                        size - strlen(output) - 1);

            } else if (remainder == 2) {

                strncat(output, ".,",
                        size - strlen(output) - 1);
            }
        }
    }
}

/* ============================================================
   TEXT CHARACTER MAPPING
   ============================================================ */

int character_to_number(wchar_t c) {

    c = towupper(c);

    /*
       Latin alphabet with Ñ.
       A-Z occupy 1-14, Ñ=15, O-Z=16-27.
    */

    if (c >= L'A' && c <= L'N')
        return (int)(c - L'A') + 1;

    if (c == L'Ñ')
        return 15;

    if (c >= L'O' && c <= L'Z')
        return (int)(c - L'O') + 16;

    /*
       Greek
    */

    const wchar_t greek[] = {
        L'Α', L'Β', L'Γ', L'Δ', L'Ε', L'Ζ',
        L'Η', L'Θ', L'Ι', L'Κ', L'Λ', L'Μ',
        L'Ν', L'Ξ', L'Ο', L'Π', L'Ρ', L'Σ',
        L'Τ', L'Υ', L'Φ', L'Χ', L'Ψ', L'Ω'
    };

    for (int i = 0; i < 24; i++) {

        if (c == greek[i])
            return 28 + i;
    }

    /*
       Cyrillic
    */

    const wchar_t cyrillic[] = {
        L'А', L'Б', L'В', L'Г', L'Д', L'Е',
        L'Ё', L'Ж', L'З', L'И', L'Й', L'К',
        L'Л', L'М', L'Н', L'О', L'П', L'Р',
        L'С', L'Т', L'У', L'Ф', L'Х', L'Ц',
        L'Ч', L'Ш', L'Щ', L'Ъ', L'Ы', L'Ь',
        L'Э', L'Ю', L'Я'
    };

    for (int i = 0; i < 33; i++) {

        if (c == cyrillic[i])
            return 52 + i;
    }

    return -1;
}

wchar_t number_to_character(int n) {

    /*
       Latin + Ñ
    */

    if (n >= 1 && n <= 14)
        return L'A' + (n - 1);

    if (n == 15)
        return L'Ñ';

    if (n >= 16 && n <= 27)
        return L'O' + (n - 16);

    /*
       Greek
    */

    const wchar_t greek[] = {
        L'Α', L'Β', L'Γ', L'Δ', L'Ε', L'Ζ',
        L'Η', L'Θ', L'Ι', L'Κ', L'Λ', L'Μ',
        L'Ν', L'Ξ', L'Ο', L'Π', L'Ρ', L'Σ',
        L'Τ', L'Υ', L'Φ', L'Χ', L'Ψ', L'Ω'
    };

    if (n >= 28 && n <= 51)
        return greek[n - 28];

    /*
       Cyrillic
    */

    const wchar_t cyrillic[] = {
        L'А', L'Б', L'В', L'Г', L'Д', L'Е',
        L'Ё', L'Ж', L'З', L'И', L'Й', L'К',
        L'Л', L'М', L'Н', L'О', L'П', L'Р',
        L'С', L'Т', L'У', L'Ф', L'Х', L'Ц',
        L'Ч', L'Ш', L'Щ', L'Ъ', L'Ы', L'Ь',
        L'Э', L'Ю', L'Я'
    };

    if (n >= 52 && n <= 84)
        return cyrillic[n - 52];

    return L'?';
}

/* ============================================================
   TEXT -> CALAPH
   ============================================================ */

void text_to_calaph(void) {

    wchar_t input[4096];

    header("TEXT", "ENCRYPT");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter ordinary text:\n");
    printf(GREEN "  > " RESET);

    if (!fgetws(input, 4096, stdin))
        return;

    printf("\n");

    printf(BOLD WHITE "  PROCESSING\n" RESET);
    line();

    printf("\n");

    for (size_t i = 0; input[i] != L'\0'; i++) {

        if (input[i] == L'\n')
            break;

        if (iswspace(input[i])) {

            printf(DIM "  [SPACE]" RESET "\n");
            continue;
        }

        int number = character_to_number(input[i]);

        if (number < 0) {

            wprintf(L"  %lc ", input[i]);
            printf(RED "→ unsupported\n" RESET);

            continue;
        }

        char encoded[1024];

        encode_integer(number, encoded, sizeof(encoded));

        wprintf(L"  %lc ", input[i]);
        printf(CYAN "→" RESET " %s\n", encoded);
    }

    printf("\n");

    printf(BOLD WHITE "  OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    for (size_t i = 0; input[i] != L'\0'; i++) {

        if (input[i] == L'\n')
            break;

        if (iswspace(input[i])) {

            printf(" / ");
            continue;
        }

        int number = character_to_number(input[i]);

        if (number < 0) {

            printf("? ");
            continue;
        }

        char encoded[1024];

        encode_integer(number, encoded, sizeof(encoded));

        printf("%s ", encoded);
    }

    printf(RESET "\n");
}

