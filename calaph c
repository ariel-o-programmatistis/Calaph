    char *token =
        strtok(input, " ");

    while (token != NULL) {

        char *end = NULL;

        errno = 0;

        long value =
            strtol(token, &end, 16);

        if (errno != 0 ||
            end == token ||
            *end != '\0' ||
            value < 0 ||
            value > 255) {

            printf("? ");

        } else if (value == 0x20) {

            printf("/ ");

        } else {

            char encoded[1024];

            encode_integer(
                (int)value,
                encoded,
                sizeof(encoded)
            );

            printf("%s ", encoded);
        }

        token = strtok(NULL, " ");
    }

    printf(RESET "\n");
}

