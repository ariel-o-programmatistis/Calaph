/* ============================================================
                     LETTER LOOKUP
   ============================================================ */

int letter_number(wchar_t ch) {
    ch = towupper(ch);

    for (size_t i = 0; i < LATIN_COUNT; i++) {
        if (latin[i].letter[0] == ch)
            return latin[i].value;
    }

    for (size_t i = 0; i < GREEK_COUNT; i++) {
        if (greek[i].letter[0] == ch)
            return greek[i].value;
    }

    for (size_t i = 0; i < CYRILLIC_COUNT; i++) {
        if (cyrillic[i].letter[0] == ch)
            return cyrillic[i].value;
    }

    return 0;
}

wchar_t number_letter(int number) {
    for (size_t i = 0; i < LATIN_COUNT; i++) {
        if (latin[i].value == number)
            return latin[i].letter[0];
    }

    for (size_t i = 0; i < GREEK_COUNT; i++) {
        if (greek[i].value == number)
            return greek[i].letter[0];
    }

    for (size_t i = 0; i < CYRILLIC_COUNT; i++) {
        if (cyrillic[i].value == number)
            return cyrillic[i].letter[0];
    }

    return L'?';
}

/* ============================================================
                       CALAPH LETTER
   ============================================================ */

void encode_letter(wchar_t ch, char *output, size_t size) {
    int number = letter_number(ch);

    if (number == 0) {
        char temp[MB_LEN_MAX];

        memset(temp, 0, sizeof(temp));
        wctomb(temp, ch);

        snprintf(output, size, "%s", temp);
        return;
    }

    char number_code[2048];
    encode_number(number, number_code, sizeof(number_code));

    snprintf(output, size, ":%s", number_code);
}

/* ============================================================
                         TEXT -> CALAPH
   ============================================================ */

void encode_text(const char *input, char *output, size_t size) {
    wchar_t wide[8192];

    mbstowcs(wide, input, sizeof(wide) / sizeof(wide[0]));

    output[0] = '\0';

    for (size_t i = 0; wide[i] != L'\0'; i++) {
        if (wide[i] == L' ') {
            strncat(output, "//", size - strlen(output) - 1);
            continue;
        }

        char encoded[4096];

        encode_letter(wide[i], encoded, sizeof(encoded));

        strncat(output, encoded, size - strlen(output) - 1);
        strncat(output, "/", size - strlen(output) - 1);
    }

    if (output[0] != '\0' &&
        output[strlen(output) - 1] == '/') {
        output[strlen(output) - 1] = '\0';
    }
}

/* ============================================================
                       CALAPH -> TEXT
   ============================================================ */

void decode_calaph(const char *input, char *output, size_t size) {
    output[0] = '\0';

    char token[4096];
    size_t token_pos = 0;

    for (size_t i = 0; input[i] != '\0'; i++) {

        if (input[i] == '/' && input[i + 1] == '/') {

            if (token_pos > 0) {
                token[token_pos] = '\0';

                if (token[0] == ':') {
                    int number = decode_number(token + 1);
                    wchar_t letter = number_letter(number);

                    char converted[MB_LEN_MAX];
                    memset(converted, 0, sizeof(converted));

                    wctomb(converted, letter);

                    strncat(output, converted,
                            size - strlen(output) - 1);
                } else {
                    strncat(output, token,
                            size - strlen(output) - 1);
                }

                token_pos = 0;
            }

            strncat(output, " ",
                    size - strlen(output) - 1);

            i++;
            continue;
        }

        if (input[i] == '/') {

            if (token_pos > 0) {
                token[token_pos] = '\0';

                if (token[0] == ':') {
                    int number = decode_number(token + 1);
                    wchar_t letter = number_letter(number);

                    char converted[MB_LEN_MAX];
                    memset(converted, 0, sizeof(converted));

                    wctomb(converted, letter);

                    strncat(output, converted,
                            size - strlen(output) - 1);
                } else {
                    strncat(output, token,
                            size - strlen(output) - 1);
                }

                token_pos = 0;
            }

            continue;
        }

        if (token_pos < sizeof(token) - 1) {
            token[token_pos++] = input[i];
        }
    }

    if (token_pos > 0) {
        token[token_pos] = '\0';

        if (token[0] == ':') {
            int number = decode_number(token + 1);
            wchar_t letter = number_letter(number);

            char converted[MB_LEN_MAX];
            memset(converted, 0, sizeof(converted));

            wctomb(converted, letter);

            strncat(output, converted,
                    size - strlen(output) - 1);
        } else {
            strncat(output, token,
                    size - strlen(output) - 1);
        }
    }
}

/* ============================================================
                          BINARY
   ============================================================ */

void text_to_binary(const char *input) {
    wchar_t wide[8192];

    mbstowcs(wide, input, sizeof(wide) / sizeof(wide[0]));

    for (size_t i = 0; wide[i] != L'\0'; i++) {
        unsigned int value = (unsigned int)wide[i];

        for (int bit = 15; bit >= 0; bit--) {
            putchar((value >> bit) & 1 ? '1' : '0');
        }

        if (wide[i + 1] != L'\0')
            putchar(' ');
    }
}

void binary_to_text(const char *input) {
    char clean[16384];
    size_t pos = 0;

    for (size_t i = 0; input[i] != '\0'; i++) {
        if (input[i] == '0' || input[i] == '1') {
            clean[pos++] = input[i];
        }
    }

    clean[pos] = '\0';

    if (pos % 8 != 0) {
        printf(RED "Invalid binary length.\n" RESET);
        return;
    }

    for (size_t i = 0; i < pos; i += 8) {
        unsigned int value = 0;

        for (int j = 0; j < 8; j++) {
            value = (value << 1) | (clean[i + j] - '0');
        }

        printf("%c", value);
    }
}

/* ============================================================
                       HEXADECIMAL
   ============================================================ */

void text_to_hex(const char *input) {
    unsigned char *p = (unsigned char *)input;

    while (*p) {
        printf("%02X", *p);

        if (*(p + 1))
            putchar(' ');

        p++;
    }
}

void hex_to_text(const char *input) {
    char byte[3];
    int pos = 0;

    for (size_t i = 0; input[i] != '\0'; i++) {

        if (isspace((unsigned char)input[i]))
            continue;

        if (!isxdigit((unsigned char)input[i])) {
            printf(RED "Invalid hexadecimal input.\n" RESET);
            return;
        }

        byte[pos++] = input[i];

        if (pos == 2) {
            byte[2] = '\0';

            unsigned int value;

            sscanf(byte, "%02X", &value);
            putchar((char)value);

            pos = 0;
        }
    }

    if (pos != 0)
        printf(RED "\nInvalid hexadecimal length.\n" RESET);
}

