/* ============================================================
                       CALAPH PRIMITIVES
   ============================================================ */

const char *primitive_number(int n) {
    switch (n) {
        case 0:  return "<>";
        case 1:  return ".";
        case 2:  return ".,";
        case 3:  return ",";
        case 4:  return ",.";
        case 5:  return ".,,";
        case 6:  return ",,";
        case 7:  return ",,.";
        case 8:  return ".,,,";
        case 9:  return ",,,";
        case 10: return ",,,.";
        default: return NULL;
    }
}

/* ============================================================
                       NUMBER ENCODING
   ============================================================ */

void encode_number(int number, char *output, size_t size) {
    char temp[4096];

    output[0] = '\0';

    if (number == 0) {
        snprintf(output, size, "<>");
        return;
    }

    if (number < 0) {
        snprintf(output, size, "-");
        encode_number(-number, temp, sizeof(temp));
        strncat(output, temp, size - strlen(output) - 1);
        return;
    }

    if (number <= 10) {
        snprintf(output, size, "%s", primitive_number(number));
        return;
    }

    /*
     * Compact multiplication.
     * Examples:
     *
     * 9  = ,' ,
     * 50 = 5 × 10
     */

    if (number == 50) {
        snprintf(output, size, ".,',,,.");
        return;
    }

    int factor;

    for (factor = 10; factor >= 2; factor--) {
        if (number % factor == 0) {
            int other = number / factor;

            char left[2048];
            char right[2048];

            encode_number(factor, left, sizeof(left));
            encode_number(other, right, sizeof(right));

            snprintf(output, size, "%s'%s", left, right);
            return;
        }
    }

    int tens = number / 10;
    int remainder = number % 10;

    if (tens > 0 && remainder > 0) {
        char left[2048];
        char right[2048];

        encode_number(tens * 10, left, sizeof(left));
        encode_number(remainder, right, sizeof(right));

        snprintf(output, size, "%s %s", left, right);
        return;
    }

    if (tens > 0) {
        encode_number(tens * 10, output, size);
        return;
    }

    encode_number(remainder, output, size);
}

/* ============================================================
                       CALAPH DECODING
   ============================================================ */

int atom_value(char c) {
    if (c == '.')
        return 1;

    if (c == ',')
        return 3;

    return 0;
}

int decode_simple_expression(const char *expression) {
    int total = 0;
    size_t i = 0;
    size_t len = strlen(expression);

    while (i < len) {
        if (expression[i] == '<' &&
            expression[i + 1] == '>') {
            i += 2;
            continue;
        }

        if (expression[i] == '.' ||
            expression[i] == ',') {
            total += atom_value(expression[i]);
        }

        i++;
    }

    return total;
}

int decode_number_term(const char *term) {
    const char *apostrophe = strchr(term, '\'');

    if (!apostrophe)
        return decode_simple_expression(term);

    if (strchr(apostrophe + 1, '\'')) {
        return 0;
    }

    char left[2048];
    char right[2048];

    size_t left_len = apostrophe - term;

    if (left_len >= sizeof(left))
        return 0;

    memcpy(left, term, left_len);
    left[left_len] = '\0';

    snprintf(right, sizeof(right), "%s", apostrophe + 1);

    int left_value = decode_simple_expression(left);
    int right_value = decode_simple_expression(right);

    return left_value * right_value;
}

int decode_number(const char *expression) {
    char copy[4096];
    snprintf(copy, sizeof(copy), "%s", expression);

    int total = 0;

    char *token = strtok(copy, " ");

    while (token != NULL) {
        total += decode_number_term(token);
        token = strtok(NULL, " ");
    }

    return total;
}

