    {'$', "...-..-"},
    {'@', ".--.-."},

    {'\0', NULL}
};

/* ------------------------------------------------------------
                       Character -> Morse
   ------------------------------------------------------------ */

static const char *char_to_morse(char c)
{
    c = (char)toupper((unsigned char)c);

    for (int i = 0; morse_table[i].character != '\0'; i++) {

        if (morse_table[i].character == c)
            return morse_table[i].code;
    }

    return NULL;
}

/* ------------------------------------------------------------
                       Morse -> Character
   ------------------------------------------------------------ */

static char morse_to_char(const char *code)
{
    for (int i = 0; morse_table[i].character != '\0'; i++) {

        if (strcmp(morse_table[i].code, code) == 0)
            return morse_table[i].character;
    }

    return '\0';
}

/* ------------------------------------------------------------
                      Calaph -> Morse
   ------------------------------------------------------------ */

static void calaph_to_morse(const char *input)
{
    char buffer[8192];
    char *token;

    strcpy(buffer, input);

    printf("\n%sMorse:%s\n\n", CYAN, RESET);

    token = strtok(buffer, " ");

    while (token != NULL) {

        long long value = evaluate_calaph(token);

        if (value < 0 || value > 255) {
            printf("%sInvalid Calaph value.%s\n",
                   RED, RESET);
            return;
        }

        char character = (char)value;

        const char *morse = char_to_morse(character);

        if (!morse) {
            printf("%s[unsupported]%s", RED, RESET);
        }
        else {
            printf("%s", morse);
        }

        token = strtok(NULL, " ");

        if (token != NULL)
            printf(" ");
    }

    printf("\n");
}

/* ------------------------------------------------------------
                      Morse -> Calaph
   ------------------------------------------------------------ */

static void morse_to_calaph(const char *input)
{
    char buffer[8192];

    strcpy(buffer, input);

    printf("\n%sCalaph:%s\n\n", CYAN, RESET);

    /*
        Words can be separated with /.

        Characters are separated by spaces.

        Example:

            .... . .-.. .-.. ---

        becomes:

            8 5 12 12 16
    */

    char *word = strtok(buffer, "/");

    int first_word = 1;

    while (word != NULL) {

        if (!first_word)
            printf("  ");

        first_word = 0;

        char *code = strtok(word, " \t");

        int first_char = 1;

        while (code != NULL) {

            char character = morse_to_char(code);

            if (character == '\0') {
                printf("%s<?>%s", RED, RESET);
            }
            else {

                if (!first_char)
                    printf(" ");

                /*
                    Convert the ASCII character into its
                    numerical value and then into Calaph.
                */

                char encoded[2048];

                encode_integer(
                    (unsigned char)character,
                    encoded,
                    sizeof(encoded)
                );

                printf("%s", encoded);
            }

            first_char = 0;

            code = strtok(NULL, " \t");
        }

        word = strtok(NULL, "/");
    }

    printf("\n");
}

