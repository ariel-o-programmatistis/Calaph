/* ============================================================
   CALAPH PRIMITIVES
   ============================================================ */

const char *primitive_for_number(int n) {

    switch (n) {

        case 0:
            return "<>";

        case 1:
            return ".";

        case 2:
            return ".,";

        case 3:
            return ",";

        case 4:
            return ",.";

        case 5:
            return ".,,";

        case 6:
            return ",,";

        case 7:
            return ",,.";

        case 8:
            return ".,,,";

        case 9:
            return ",,,";

        case 10:
            return ",,,.";

        default:
            return NULL;
    }
}

/* ============================================================
   CALAPH PRIMITIVE PARSER
   ============================================================ */

int parse_primitive(const char *s) {

    if (s == NULL || s[0] == '\0')
        return -1;

    if (strcmp(s, "<>") == 0)
        return 0;

    int value = 0;

    for (size_t i = 0; s[i] != '\0'; i++) {

        if (s[i] == '.')
            value += 1;

        else if (s[i] == ',')
            value += 3;

        else
            return -1;
    }

    return value;
}

/* ============================================================
   CALAPH PRODUCT PARSER
   ============================================================ */

int parse_product(const char *s) {

    if (s == NULL || s[0] == '\0')
        return -1;

    /*
       Special canonical representation:

       .,',,. = 50

       This representation is retained explicitly as part
       of the Calaph numerical system.
    */

    if (strcmp(s, ".,',,.") == 0)
        return 50;

    char buffer[TOKEN_SIZE];

    strncpy(buffer, s, sizeof(buffer) - 1);
    buffer[sizeof(buffer) - 1] = '\0';

    char *apostrophe = strchr(buffer, '\'');

    if (!apostrophe)
        return parse_primitive(buffer);

    /*
       Only one multiplication operator is permitted.
    */

    if (strchr(apostrophe + 1, '\''))
        return -1;

    *apostrophe = '\0';

    if (buffer[0] == '\0' ||
        apostrophe[1] == '\0')
        return -1;

    int left = parse_primitive(buffer);
    int right = parse_primitive(apostrophe + 1);

    if (left < 0 || right < 0)
        return -1;

    return left * right;
}

/* ============================================================
   CALAPH EXPRESSION EVALUATOR
   ============================================================ */

int evaluate_calaph(const char *expression) {

    if (expression == NULL ||
        expression[0] == '\0')
        return -1;

    char buffer[INPUT_SIZE];

    strncpy(buffer, expression, sizeof(buffer) - 1);
    buffer[sizeof(buffer) - 1] = '\0';

    int total = 0;
    int token_count = 0;

    char *token = strtok(buffer, " ");

    while (token != NULL) {

        int value = parse_product(token);

        if (value < 0)
            return -1;

        total += value;
        token_count++;

        token = strtok(NULL, " ");
    }

    if (token_count == 0)
        return -1;

    return total;
}

/* ============================================================
   INTEGER -> CALAPH
   ============================================================ */

void append_text(
    char *output,
    size_t size,
    const char *text
) {

    if (!output || !text || size == 0)
        return;

    size_t current = strlen(output);

    if (current >= size - 1)
        return;

    strncat(
        output,
        text,
        size - current - 1
    );
}

/* ============================================================
   APPEND ADDITION
   ============================================================ */

void append_calaph_term(
    char *output,
    size_t size,
    const char *term
) {

    if (output[0] != '\0')
        append_text(output, size, " ");

    append_text(output, size, term);
}

/* ============================================================
   INTEGER ENCODER
   ============================================================ */

void encode_integer(
    int value,
    char *output,
    size_t size
) {

    if (!output || size == 0)
        return;

    output[0] = '\0';

    if (value < 0) {
        append_text(output, size, "?");
        return;
    }

    if (value == 0) {
        append_text(output, size, "<>");
        return;
    }

    /*
       Canonical 100.
    */

    const char *hundred = ",,,.' ,,,.";

    /*
       50 is explicitly defined by Calaph as:

       .,',,.
    */

    while (value >= 100) {

        append_calaph_term(
            output,
            size,
            hundred
        );

        value -= 100;
    }

    while (value >= 50) {

        append_calaph_term(
            output,
            size,
            ".,',,."
        );

        value -= 50;
    }

    if (value > 0) {

        if (value <= 10) {

            const char *primitive =
                primitive_for_number(value);

            if (primitive)
                append_calaph_term(
                    output,
                    size,
                    primitive
                );

        } else {

            int threes = value / 3;
            int remainder = value % 3;

            char term[256];

            term[0] = '\0';

            for (int i = 0; i < threes; i++)
                append_text(term, sizeof(term), ",");

            if (remainder == 1)
                append_text(term, sizeof(term), ".");

            else if (remainder == 2)
                append_text(term, sizeof(term), ".,");

            append_calaph_term(
                output,
                size,
                term
            );
        }
    }
}

/* ============================================================
   CHARACTER MAPPING
   ============================================================ */

int character_to_number(wchar_t c) {

    c = towupper(c);

    /* Latin */

    if (c >= L'A' && c <= L'N')
        return (int)(c - L'A') + 1;

    if (c == L'Ñ')
        return 15;

    if (c >= L'O' && c <= L'Z')
        return (int)(c - L'O') + 16;

    /* Greek */

    const wchar_t greek[] = {

        L'Α', L'Β', L'Γ', L'Δ', L'Ε', L'Ζ',
        L'Η', L'Θ', L'Ι', L'Κ', L'Λ', L'Μ',
        L'Ν', L'Ξ', L'Ο', L'Π', L'Ρ', L'Σ',
        L'Τ', L'Υ', L'Φ', L'Χ', L'Ψ', L'Ω'
    };

    for (int i = 0; i < 24; i++) {

        if (c == greek[i])
            return 28 + i;
    }

    /* Cyrillic */

    const wchar_t cyrillic[] = {

        L'А', L'Б', L'В', L'Г', L'Д', L'Е',
        L'Ё', L'Ж', L'З', L'И', L'Й', L'К',
        L'Л', L'М', L'Н', L'О', L'П', L'Р',
        L'С', L'Т', L'У', L'Ф', L'Х', L'Ц',
        L'Ч', L'Ш', L'Щ', L'Ъ', L'Ы', L'Ь',
        L'Э', L'Ю', L'Я'
    };

    for (int i = 0; i < 33; i++) {

        if (c == cyrillic[i])
            return 52 + i;
    }

    return -1;
}

/* ============================================================
   NUMBER -> CHARACTER
   ============================================================ */

wchar_t number_to_character(int n) {

    if (n >= 1 && n <= 14)
        return L'A' + (n - 1);

    if (n == 15)
        return L'Ñ';

    if (n >= 16 && n <= 27)
        return L'O' + (n - 16);

    const wchar_t greek[] = {

        L'Α', L'Β', L'Γ', L'Δ', L'Ε', L'Ζ',
        L'Η', L'Θ', L'Ι', L'Κ', L'Λ', L'Μ',
        L'Ν', L'Ξ', L'Ο', L'Π', L'Ρ', L'Σ',
        L'Τ', L'Υ', L'Φ', L'Χ', L'Ψ', L'Ω'
    };

    if (n >= 28 && n <= 51)
        return greek[n - 28];

    const wchar_t cyrillic[] = {

        L'А', L'Б', L'В', L'Г', L'Д', L'Е',
        L'Ё', L'Ж', L'З', L'И', L'Й', L'К',
        L'Л', L'М', L'Н', L'О', L'П', L'Р',
        L'С', L'Т', L'У', L'Ф', L'Х', L'Ц',
        L'Ч', L'Ш', L'Щ', L'Ъ', L'Ы', L'Ь',
        L'Э', L'Ю', L'Я'
    };

    if (n >= 52 && n <= 84)
        return cyrillic[n - 52];

    return L'?';
}

/* ============================================================
   WIDE CHARACTER OUTPUT
   ============================================================ */

void print_wide_character(wchar_t c) {

    char buffer[MB_LEN_MAX];
    mbstate_t state;

    memset(&state, 0, sizeof(state));

    size_t length =
        wcrtomb(buffer, c, &state);

    if (length == (size_t)-1) {

        printf("?");

        return;
    }

    fwrite(
        buffer,
        1,
        length,
        stdout
    );
}

/* ============================================================
   TEXT -> CALAPH
   ============================================================ */

void text_to_calaph(void) {

    wchar_t input[INPUT_SIZE];

    header("TEXT", "ENCRYPT");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter ordinary text:\n");
    printf(GREEN "  > " RESET);
    fflush(stdout);

    if (fgetws(input, INPUT_SIZE, stdin) == NULL)
        return;

    printf("\n");

    printf(BOLD WHITE "  PROCESSING\n" RESET);
    line();

    printf("\n");

    for (size_t i = 0;
         input[i] != L'\0';
         i++) {

        if (input[i] == L'\n')
            break;

        if (iswspace(input[i])) {

            printf(DIM "  [SPACE]" RESET "\n");

            continue;
        }

        int number =
            character_to_number(input[i]);

        print_wide_character(input[i]);

        printf(" ");

        if (number < 0) {

            printf(RED "→ unsupported\n" RESET);

            continue;
        }

        char encoded[1024];

        encode_integer(
            number,
            encoded,
            sizeof(encoded)
        );

        printf(
            CYAN "→" RESET " %s\n",
            encoded
        );
    }

    printf("\n");

    printf(BOLD WHITE "  OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    for (size_t i = 0;
         input[i] != L'\0';
         i++) {

        if (input[i] == L'\n')
            break;

        if (iswspace(input[i])) {

            printf(" / ");

            continue;
        }

        int number =
            character_to_number(input[i]);

        if (number < 0) {

            printf("? ");

            continue;
        }

        char encoded[1024];

        encode_integer(
            number,
            encoded,
            sizeof(encoded)
        );

        printf("%s ", encoded);
    }

    printf(RESET "\n");
}

/* ============================================================
   CALAPH -> TEXT
   ============================================================ */

void calaph_to_text(void) {

    char input[INPUT_SIZE];

    header("TEXT", "DECRYPT");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter Calaph:\n");
    printf(GREEN "  > " RESET);
    fflush(stdout);

    if (!read_line(input, sizeof(input)))
        return;

    printf("\n");

    printf(BOLD WHITE "  OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    char *token =
        strtok(input, " ");

    while (token != NULL) {

        if (strcmp(token, "/") == 0) {

            printf(" ");

        } else {

            int value =
                evaluate_calaph(token);

            if (value >= 1 &&
                value <= 84) {

                wchar_t character =
                    number_to_character(value);

                print_wide_character(character);

            } else {

                printf("?");
            }
        }

        token = strtok(NULL, " ");
    }

    printf(RESET "\n");
}

/* ============================================================
   MORSE ENCODING
   ============================================================ */

const char *morse_encode_char(char c) {

    switch (toupper((unsigned char)c)) {

        case 'A': return ".-";
        case 'B': return "-...";
        case 'C': return "-.-.";
        case 'D': return "-..";
        case 'E': return ".";
        case 'F': return "..-.";
        case 'G': return "--.";
        case 'H': return "....";
        case 'I': return "..";
        case 'J': return ".---";
        case 'K': return "-.-";
        case 'L': return ".-..";
        case 'M': return "--";
        case 'N': return "-.";
        case 'O': return "---";
        case 'P': return ".--.";
        case 'Q': return "--.-";
        case 'R': return ".-.";
        case 'S': return "...";
        case 'T': return "-";
        case 'U': return "..-";
        case 'V': return "...-";
        case 'W': return ".--";
        case 'X': return "-..-";
        case 'Y': return "-.--";
        case 'Z': return "--..";

        case '0': return "-----";
        case '1': return ".----";
        case '2': return "..---";
        case '3': return "...--";
        case '4': return "....-";
        case '5': return ".....";
        case '6': return "-....";
        case '7': return "--...";
        case '8': return "---..";
        case '9': return "----.";

        default:
            return NULL;
    }
}

/* ============================================================
   MORSE DECODING
   ============================================================ */

char morse_decode_code(const char *code) {

    const char *codes[] = {

        ".-", "-...", "-.-.", "-..", ".", "..-.",
        "--.", "....", "..", ".---", "-.-", ".-..",
        "--", "-.", "---", ".--.", "--.-", ".-.",
        "...", "-", "..-", "...-", ".--", "-..-",
        "-.--", "--.."
    };

    for (int i = 0; i < 26; i++) {

        if (strcmp(code, codes[i]) == 0)
            return 'A' + i;
    }

    const char *digits[] = {

        "-----", ".----", "..---", "...--", "....-",
        ".....", "-....", "--...", "---..", "----."
    };

    for (int i = 0; i < 10; i++) {

        if (strcmp(code, digits[i]) == 0)
            return '0' + i;
    }

    return '?';
}

/* ============================================================
   CALAPH -> MORSE
   ============================================================ */

void calaph_to_morse(void) {

    char input[INPUT_SIZE];

    header("CODES", "CALAPH → MORSE");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter Calaph:\n");
    printf(GREEN "  > " RESET);
    fflush(stdout);

    if (!read_line(input, sizeof(input)))
        return;

    printf("\n");

    printf(BOLD WHITE "  MORSE OUTPUT\n" RESET);
    line();

    printf(GREEN "  ");

    char *token =
        strtok(input, " ");

    while (token != NULL) {

        if (strcmp(token, "/") == 0) {

            printf("/ ");

        } else {

            int value =
                evaluate_calaph(token);

            if (value >= 1 &&
                value <= 26) {

                char c =
                    'A' + value - 1;

                const char *morse =
                    morse_encode_char(c);

                if (morse)
                    printf("%s ", morse);
                else
                    printf("? ");

            } else {

                printf("? ");
            }
        }

        token = strtok(NULL, " ");
    }

    printf(RESET "\n");
}

