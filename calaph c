/* ============================================================
   BINARY -> CALAPH
   ============================================================ */

void binary_to_calaph(void) {

    char input[8192];

    header("CODES", "BINARY → CALAPH");

    printf(BOLD WHITE "  INPUT\n" RESET);
    line();

    printf("  Enter binary:\n");
